  WORKER_LABEL="worker-$K6_WORKER_INDEX"
fi

mkdir -p "$LOG_DIR" "$RESULT_ROOT/k6/$PROFILE/$WORKER_LABEL" "$RESULT_ROOT/metrics"
exec > >(tee -a "$LOG_DIR/k6-startup.log") 2>&1

apt_update_with_retry() {
  local attempt
  local delay
  for attempt in $(seq 1 5); do
    echo "[apt] update attempt $attempt/5"
    if apt-get update -o Acquire::Retries=3; then
      return 0
    fi
    delay=$((attempt * 10))
    echo "[apt] update failed attempt $attempt; retrying in $delay seconds" >&2
    apt-get clean || true
    rm -rf /var/lib/apt/lists/partial/* || true
    sleep "$delay"
  done
  echo "[apt] update failed after retries" >&2
  return 1
}

apt_install_with_retry() {
  local attempt
  local delay
  for attempt in $(seq 1 3); do
    echo "[apt] install attempt $attempt/3 packages=$*"
    if apt-get install -y "$@"; then
      return 0
    fi
    delay=$((attempt * 10))
    echo "[apt] install failed attempt $attempt; retrying in $delay seconds" >&2
    sleep "$delay"
  done
  echo "[apt] install failed after retries packages=$*" >&2
  return 1
}

apply_socket_tuning() {
  ulimit -n 1048576 || ulimit -n 65535 || true
  sysctl -w net.core.somaxconn=65535 || true
  sysctl -w net.ipv4.tcp_max_syn_backlog=65535 || true
  sysctl -w net.core.netdev_max_backlog=250000 || true
  sysctl -w net.ipv4.tcp_fin_timeout=15 || true
  sysctl -w net.ipv4.ip_local_port_range="1024 65535" || true
  sysctl -w net.ipv4.tcp_tw_reuse=1 || true
}

collect_socket_snapshot() {
  local name="$1"
  {
    echo "timestamp=$(date -Iseconds)"
    echo "ulimit_n=$(ulimit -n)"
    sysctl net.core.somaxconn net.ipv4.tcp_max_syn_backlog net.core.netdev_max_backlog \
      net.ipv4.tcp_fin_timeout net.ipv4.ip_local_port_range net.ipv4.tcp_tw_reuse 2>/dev/null || true
    echo
    ss -s || true
    echo
    ss -tan state established | head -n 2000 || true
    echo
    ss -tan state syn-recv | head -n 2000 || true
  } > "$RESULT_ROOT/metrics/k6-$WORKER_LABEL-$name.txt" 2>&1
}

collect_db_message_count() {
  local label="$1"
  local output_dir="$2"
  local safe_label="$${label//\'/}"
  local output_file="$output_dir/$${safe_label}-db-message-count.json"

  if ! command -v mysql >/dev/null 2>&1; then
    echo "{\"label\":\"$safe_label\",\"error\":\"mysql client not installed\"}" > "$output_file"
    return 0
  fi

  local db_count
  db_count=$(mysql \
    --connect-timeout=5 \
    -h "$MYSQL_INTERNAL_IP" \
    -uopenchat \
    -popenchat \
    -D openchat \
    -N -B \
    -e "SELECT COUNT(*) FROM chat_message WHERE client_message_id LIKE '$${safe_label}-%';" 2>"$output_dir/$${safe_label}-db-message-count.err" || true)

  if [ -z "$db_count" ]; then
    echo "{\"label\":\"$safe_label\",\"error\":\"query failed\"}" > "$output_file"
    return 0
  fi

  cat > "$output_file" <<EOF
{
  "label": "$safe_label",
  "clientMessageIdPrefix": "$safe_label",
  "dbMessageRows": $db_count
}
EOF
}

json_metric_value() {
  local summary_file="$1"
  local metric="$2"
  local field="$3"
  if [ ! -f "$summary_file" ]; then
    echo 0
    return 0
  fi
  jq -r --arg metric "$metric" --arg field "$field" '
    .metrics[$metric] as $m
    | if $m == null then 0
      elif (($m.values // {})[$field] != null) then ($m.values // {})[$field]
      elif ($m[$field] != null) then $m[$field]
      elif ($field == "rate" and $m.value != null) then $m.value
      else 0
      end
  ' "$summary_file" 2>/dev/null || echo 0
}

json_metric_value_by_tags() {
  local summary_file="$1"
  local metric="$2"
  local field="$3"
  shift 3
  if [ ! -f "$summary_file" ]; then
    echo 0
    return 0
  fi
  jq -r --arg metric "$metric" --arg field "$field" --argjson tags_json "$(printf '%s\n' "$@" | jq -R 'split("=") | {(.[0]): .[1]}' | jq -s add)" '
    def key_tags:
      capture("^[^{]+\\{(?<tags>.*)\\}$").tags
      | split(",")
      | map(select(length > 0) | split(":") | {(.[0]): .[1]})
      | add // {};
    def metric_value($m; $field):
      if $m == null then 0
      elif (($m.values // {})[$field] != null) then ($m.values // {})[$field]
      elif ($m[$field] != null) then $m[$field]
      elif ($field == "rate" and $m.value != null) then $m.value
      else 0
      end;
    .metrics as $metrics
    | ($metrics
      | to_entries
      | map(select(.key | startswith($metric + "{")))
      | map(select((.key | key_tags) as $tags | ($tags_json | to_entries | all($tags[.key] == .value))))
      | .[0].value) as $m
    | metric_value($m; $field)
  ' "$summary_file" 2>/dev/null || echo 0
}

json_metric_present() {
  local summary_file="$1"
  local metric="$2"
  if [ ! -f "$summary_file" ]; then
    echo "false"
    return 0
  fi
  jq -r --arg metric "$metric" 'if .metrics[$metric] == null then "false" else "true" end' "$summary_file" 2>/dev/null || echo "false"
}

json_metric_present_by_tags() {
  local summary_file="$1"
  local metric="$2"
  shift 2
  if [ ! -f "$summary_file" ]; then
    echo "false"
    return 0
  fi
  jq -r --arg metric "$metric" --argjson tags_json "$(printf '%s\n' "$@" | jq -R 'split("=") | {(.[0]): .[1]}' | jq -s add)" '
    def key_tags:
      capture("^[^{]+\\{(?<tags>.*)\\}$").tags
      | split(",")
      | map(select(length > 0) | split(":") | {(.[0]): .[1]})
      | add // {};
    .metrics
    | to_entries
    | map(select(.key | startswith($metric + "{")))
    | map(select((.key | key_tags) as $tags | ($tags_json | to_entries | all($tags[.key] == .value))))
    | if length > 0 then "true" else "false" end
  ' "$summary_file" 2>/dev/null || echo "false"
}

number_as_int() {
  local value="$1"
  awk -v value="$value" 'BEGIN { printf "%.0f", value + 0 }'
}

less_than_or_disabled() {
  local value="$1"
  local threshold="$2"
  awk -v value="$value" -v threshold="$threshold" 'BEGIN {
    if (threshold <= 0) exit 0
    exit !(value < threshold)
  }'
}

metric_gate_status() {
  local value="$1"
  local threshold="$2"
  if awk -v threshold="$threshold" 'BEGIN { exit !(threshold <= 0) }'; then
    echo "COLLECTED"
    return 0
  fi
  if less_than_or_disabled "$value" "$threshold"; then
    echo "PASS"
  else
    echo "PARTIAL"
  fi
}

metric_gate_status_with_data() {
  local value="$1"
  local threshold="$2"
  local metric_present="$3"
  local sample_count="$4"
  if awk -v threshold="$threshold" 'BEGIN { exit !(threshold <= 0) }'; then
    echo "COLLECTED"
    return 0
  fi
  if [ "$metric_present" != "true" ] || [ "$sample_count" -le 0 ]; then
    echo "NO_DATA"
    return 0
  fi
  metric_gate_status "$value" "$threshold"
}

write_post_stop_probe_result() {
  local label="$1"
  local target_node="$2"
  local probe_status="$3"
  local summary_file="$4"
  local db_file="$5"
  local output_file="$6"

  local sent
  local ack
  local db_rows
  local route_failures
  local route_fallbacks
  local route_mismatches
  local latest_p95
  local latest_p99
  local latest_present
  local visible_samples
  local visible_p95
  local visible_p99
  local freshness_status
  sent="$(number_as_int "$(json_metric_value "$summary_file" "ws_messages_sent_total" "count")")"
  ack="$(number_as_int "$(json_metric_value "$summary_file" "ws_acks_received_total" "count")")"
  db_rows="$(jq -r '.dbMessageRows // 0' "$db_file" 2>/dev/null || echo 0)"
  route_failures="$(number_as_int "$(json_metric_value "$summary_file" "ws_route_failures_total" "count")")"
  route_fallbacks="$(number_as_int "$(json_metric_value "$summary_file" "ws_route_fallback_total" "count")")"
  route_mismatches="$(number_as_int "$(json_metric_value "$summary_file" "ws_route_assignment_mismatch_total" "count")")"
  latest_p95="$(json_metric_value_by_tags "$summary_file" "ws_visible_latest_freshness_ms" "p(95)" "presenceMode=active" "clientMode=observer" "roomType=hot")"
  latest_p99="$(json_metric_value_by_tags "$summary_file" "ws_visible_latest_freshness_ms" "p(99)" "presenceMode=active" "clientMode=observer" "roomType=hot")"
  latest_present="$(json_metric_present_by_tags "$summary_file" "ws_visible_latest_freshness_ms" "presenceMode=active" "clientMode=observer" "roomType=hot")"
  visible_samples="$(number_as_int "$(json_metric_value "$summary_file" "ws_visible_latest_slo_samples_total" "count")")"
  visible_p95="$(json_metric_value "$summary_file" "ws_visible_freshness_ms" "p(95)")"
  visible_p99="$(json_metric_value "$summary_file" "ws_visible_freshness_ms" "p(99)")"
  freshness_status="$(metric_gate_status_with_data "$latest_p95" "$K6_VISIBLE_LATEST_FRESHNESS_P95_THRESHOLD_MS" "$latest_present" "$visible_samples")"

  local correctness_status="PASS"
  if [ "$probe_status" -ne 0 ] || [ "$route_failures" -ne 0 ] || [ "$route_fallbacks" -ne 0 ] || [ "$route_mismatches" -ne 0 ] || [ "$sent" -ne "$ack" ] || [ "$sent" -ne "$db_rows" ]; then
    correctness_status="FAIL"
  fi

  jq -n \
    --arg gate_label "$label" \
    --arg targetNode "$target_node" \
    --arg correctnessResult "$correctness_status" \
    --arg freshnessResult "$freshness_status" \
    --argjson exitCode "$probe_status" \
    --argjson thresholdExitCode 0 \
    --argjson sent "$sent" \
    --argjson ack "$ack" \
    --argjson dbRows "$db_rows" \
    --argjson routeFailures "$route_failures" \
    --argjson routeFallbacks "$route_fallbacks" \
    --argjson routeMismatches "$route_mismatches" \
    --argjson latestP95 "$latest_p95" \
    --argjson latestP99 "$latest_p99" \
    --argjson visibleSamples "$visible_samples" \
    --argjson visibleP95 "$visible_p95" \
    --argjson visibleP99 "$visible_p99" \
    '{
      "label": $gate_label,
      "targetNode": $targetNode,
      "correctnessResult": $correctnessResult,
      "freshnessResult": $freshnessResult,
      "exitCode": $exitCode,
      "thresholdExitCode": $thresholdExitCode,
      "sent": $sent,
      "ack": $ack,
      "dbRows": $dbRows,
      "routeFailures": $routeFailures,
      "routeFallbacks": $routeFallbacks,
      "routeMismatches": $routeMismatches,
      "latestFreshnessP95": $latestP95,
      "latestFreshnessP99": $latestP99,
      "observerVisibleSamples": $visibleSamples,
      "visibleFreshnessP95": $visibleP95,
      "visibleFreshnessP99": $visibleP99
    }' > "$output_file"
}

write_validation_gates() {
  # Gate sections: correctness:, drainTermination:, performance:, postStopFreshness:, cleanup:
  local label="$1"
  local output_dir="$2"
  local summary_file="$3"
  local db_file="$4"
  local raw_k6_status="$5"
  local node_drain_status="$6"
  local gate_file="$RESULT_ROOT/metrics/validation-gates-$label.json"
  local rolling_file="$RESULT_ROOT/metrics/rolling-restart-$label.json"
  local post_stop_file="$RESULT_ROOT/metrics/post-stop-probe-rr-$label-n*.json"

  local sent
  local ack
  local db_rows
  local route_failures
  local route_fallbacks
  local route_mismatches
  local preflight_failures
  local http_error_rate
  local connect_failure_rate
  local ack_p95
  local ack_p99
  local latest_p95
  local latest_p99
  local latest_present
  local visible_samples
  local visible_p95
  local visible_p99
  local visible_gap_p95
  local visible_gap_p99
  local visible_gap_max
  local handler_duration_p95
  local handler_duration_p99
  local json_parse_duration_p95
  local json_parse_duration_p99
  local batch_messages_p95
  local batch_messages_p99
  sent="$(number_as_int "$(json_metric_value "$summary_file" "ws_messages_sent_total" "count")")"
  ack="$(number_as_int "$(json_metric_value "$summary_file" "ws_acks_received_total" "count")")"
  db_rows="$(jq -r '.dbMessageRows // 0' "$db_file" 2>/dev/null || echo 0)"
  route_failures="$(number_as_int "$(json_metric_value "$summary_file" "ws_route_failures_total" "count")")"
  route_fallbacks="$(number_as_int "$(json_metric_value "$summary_file" "ws_route_fallback_total" "count")")"
  route_mismatches="$(number_as_int "$(json_metric_value "$summary_file" "ws_route_assignment_mismatch_total" "count")")"
  preflight_failures="$(number_as_int "$(json_metric_value "$summary_file" "assignment_preflight_failures_total" "count")")"
  http_error_rate="$(json_metric_value "$summary_file" "http_error_rate" "rate")"
  connect_failure_rate="$(json_metric_value "$summary_file" "ws_connect_failure_rate" "rate")"
  ack_p95="$(json_metric_value "$summary_file" "chat_ack_roundtrip_ms" "p(95)")"
  ack_p99="$(json_metric_value "$summary_file" "chat_ack_roundtrip_ms" "p(99)")"
  latest_p95="$(json_metric_value_by_tags "$summary_file" "ws_visible_latest_freshness_ms" "p(95)" "presenceMode=active" "clientMode=observer" "roomType=hot")"
  latest_p99="$(json_metric_value_by_tags "$summary_file" "ws_visible_latest_freshness_ms" "p(99)" "presenceMode=active" "clientMode=observer" "roomType=hot")"
  latest_present="$(json_metric_present_by_tags "$summary_file" "ws_visible_latest_freshness_ms" "presenceMode=active" "clientMode=observer" "roomType=hot")"
  visible_samples="$(number_as_int "$(json_metric_value "$summary_file" "ws_visible_latest_slo_samples_total" "count")")"
  visible_p95="$(json_metric_value "$summary_file" "ws_visible_freshness_ms" "p(95)")"
  visible_p99="$(json_metric_value "$summary_file" "ws_visible_freshness_ms" "p(99)")"
  visible_gap_p95="$(json_metric_value "$summary_file" "ws_visible_gap_messages" "p(95)")"
  visible_gap_p99="$(json_metric_value "$summary_file" "ws_visible_gap_messages" "p(99)")"
  visible_gap_max="$(json_metric_value "$summary_file" "ws_visible_gap_messages" "max")"
  handler_duration_p95="$(json_metric_value "$summary_file" "ws_message_handler_duration_ms" "p(95)")"
  handler_duration_p99="$(json_metric_value "$summary_file" "ws_message_handler_duration_ms" "p(99)")"
  json_parse_duration_p95="$(json_metric_value "$summary_file" "ws_json_parse_duration_ms" "p(95)")"
  json_parse_duration_p99="$(json_metric_value "$summary_file" "ws_json_parse_duration_ms" "p(99)")"
  batch_messages_p95="$(json_metric_value "$summary_file" "ws_batch_messages_per_frame" "p(95)")"
  batch_messages_p99="$(json_metric_value "$summary_file" "ws_batch_messages_per_frame" "p(99)")"

  local correctness_status="PASS"
  if [ ! -f "$summary_file" ] || [ "$route_failures" -ne 0 ] || [ "$route_fallbacks" -ne 0 ] || [ "$route_mismatches" -ne 0 ] || [ "$preflight_failures" -ne 0 ] || [ "$sent" -ne "$ack" ] || [ "$sent" -ne "$db_rows" ]; then
    correctness_status="FAIL"
  fi
  if ! less_than_or_disabled "$http_error_rate" "0.01" || ! less_than_or_disabled "$connect_failure_rate" "0.01"; then
    correctness_status="FAIL"
  fi

  local drain_status="NOT_APPLICABLE"
  local rolling_result=""
  local termination_allowed="false"
  local delivery_complete="false"
  local gcp_stopped_count=0
  local post_stop_correctness="NOT_APPLICABLE"
  local post_stop_freshness="NOT_APPLICABLE"
  local post_stop_exit_code=0
  if [ -f "$rolling_file" ]; then
    rolling_result="$(jq -r '.result // ""' "$rolling_file" 2>/dev/null || echo "")"
    termination_allowed="$(jq -r '.terminationAllowed // false' "$rolling_file" 2>/dev/null || echo false)"
    delivery_complete="$(jq -r '.allDeliveryEvidenceComplete // false' "$rolling_file" 2>/dev/null || echo false)"
    gcp_stopped_count="$(jq -r '.gcpStoppedCount // 0' "$rolling_file" 2>/dev/null || echo 0)"
    post_stop_exit_code="$(jq -r '.postStopProbe.exitCode // 0' "$rolling_file" 2>/dev/null || echo 0)"
    if [ "$node_drain_status" -eq 0 ] && [ "$rolling_result" = "complete" ] && [ "$termination_allowed" = "true" ] && [ "$delivery_complete" = "true" ]; then
      drain_status="PASS"
    else
      drain_status="FAIL"
    fi
  elif [ "$node_drain_status" -eq 0 ]; then
    drain_status="NOT_APPLICABLE"
  else
    drain_status="FAIL"
  fi

  local matched_post_stop_file=""
  for candidate in $post_stop_file; do
    if [ -f "$candidate" ]; then
      matched_post_stop_file="$candidate"
      break
    fi
  done
  if [ -n "$matched_post_stop_file" ]; then
    post_stop_correctness="$(jq -r '.correctnessResult // "NOT_APPLICABLE"' "$matched_post_stop_file" 2>/dev/null || echo "NOT_APPLICABLE")"
    post_stop_freshness="$(jq -r '.freshnessResult // "NOT_APPLICABLE"' "$matched_post_stop_file" 2>/dev/null || echo "NOT_APPLICABLE")"
  fi

  local performance_status
  local ack_status
  local latest_status
  ack_status="$(metric_gate_status "$ack_p95" "$K6_CHAT_ACK_P95_THRESHOLD_MS")"
  latest_status="$(metric_gate_status_with_data "$latest_p95" "$K6_VISIBLE_LATEST_FRESHNESS_P95_THRESHOLD_MS" "$latest_present" "$visible_samples")"
  performance_status="PASS"
  if [ "$latest_status" = "NO_DATA" ]; then
    performance_status="FAIL"
  elif [ "$ack_status" = "PARTIAL" ] || [ "$latest_status" = "PARTIAL" ]; then
    performance_status="PARTIAL"
  elif [ "$ack_status" = "COLLECTED" ] || [ "$latest_status" = "COLLECTED" ]; then
    performance_status="COLLECTED"
  fi

  jq -n \
    --arg gate_label "$label" \
    --arg correctnessStatus "$correctness_status" \
    --arg drainStatus "$drain_status" \
    --arg performanceStatus "$performance_status" \
    --arg ackStatus "$ack_status" \
    --arg latestStatus "$latest_status" \
    --arg postStopCorrectness "$post_stop_correctness" \
    --arg postStopFreshness "$post_stop_freshness" \
    --arg rollingResult "$rolling_result" \
    --argjson rawK6ExitCode "$raw_k6_status" \
    --argjson effectiveExitCode "$node_drain_status" \
    --argjson sent "$sent" \
    --argjson ack "$ack" \
    --argjson dbRows "$db_rows" \
    --argjson routeFailures "$route_failures" \
    --argjson routeFallbacks "$route_fallbacks" \
    --argjson routeMismatches "$route_mismatches" \
    --argjson preflightFailures "$preflight_failures" \
    --argjson httpErrorRate "$http_error_rate" \
    --argjson connectFailureRate "$connect_failure_rate" \
    --argjson ackP95 "$ack_p95" \
    --argjson ackP99 "$ack_p99" \
    --argjson latestP95 "$latest_p95" \
    --argjson latestP99 "$latest_p99" \
    --argjson visibleSamples "$visible_samples" \
    --argjson visibleP95 "$visible_p95" \
    --argjson visibleP99 "$visible_p99" \
    --argjson visibleGapP95 "$visible_gap_p95" \
    --argjson visibleGapP99 "$visible_gap_p99" \
    --argjson visibleGapMax "$visible_gap_max" \
    --argjson handlerDurationP95 "$handler_duration_p95" \
    --argjson handlerDurationP99 "$handler_duration_p99" \
    --argjson jsonParseDurationP95 "$json_parse_duration_p95" \
    --argjson jsonParseDurationP99 "$json_parse_duration_p99" \
    --argjson batchMessagesP95 "$batch_messages_p95" \
    --argjson batchMessagesP99 "$batch_messages_p99" \
    --argjson gcpStoppedCount "$gcp_stopped_count" \
    --argjson postStopExitCode "$post_stop_exit_code" \
    --arg terminationAllowed "$termination_allowed" \
    --arg deliveryComplete "$delivery_complete" \
    '{
      "label": $gate_label,
      "correctness": {
        "status": $correctnessStatus,
        "rawK6ExitCode": $rawK6ExitCode,
        "sent": $sent,
        "ack": $ack,
        "dbRows": $dbRows,
        "routeFailures": $routeFailures,
        "routeFallbacks": $routeFallbacks,
        "routeMismatches": $routeMismatches,
        "assignmentPreflightFailures": $preflightFailures,
        "httpErrorRate": $httpErrorRate,
        "connectFailureRate": $connectFailureRate
      },
      "drainTermination": {
        "status": $drainStatus,
        "rollingResult": $rollingResult,
        "terminationAllowed": ($terminationAllowed == "true"),
        "deliveryEvidenceComplete": ($deliveryComplete == "true"),
        "gcpStoppedCount": $gcpStoppedCount,
        "postStopProbeExitCode": $postStopExitCode
      },
      "performance": {
        "status": $performanceStatus,
        "ackStatus": $ackStatus,
        "latestFreshnessStatus": $latestStatus,
        "ackP95": $ackP95,
        "ackP99": $ackP99,
        "latestFreshnessP95": $latestP95,
        "latestFreshnessP99": $latestP99,
        "observerVisibleSamples": $visibleSamples
      },
      "postStopFreshness": {
        "status": $postStopFreshness,
        "correctnessResult": $postStopCorrectness
      },
      "cleanup": {
        "status": "DEFERRED_TO_RUNNER"
      },
      "diagnostics": {
        "visibleFreshnessP95": $visibleP95,
        "visibleFreshnessP99": $visibleP99,
        "visibleGapP95": $visibleGapP95,
        "visibleGapP99": $visibleGapP99,
        "visibleGapMax": $visibleGapMax,
        "handlerDurationP95": $handlerDurationP95,
        "handlerDurationP99": $handlerDurationP99,
        "jsonParseDurationP95": $jsonParseDurationP95,
        "jsonParseDurationP99": $jsonParseDurationP99,
        "batchMessagesP95": $batchMessagesP95,
        "batchMessagesP99": $batchMessagesP99
      },
      "visibleFreshnessP95": $visibleP95,
      "visibleFreshnessP99": $visibleP99,
      "visibleGapP95": $visibleGapP95,
      "visibleGapP99": $visibleGapP99,
      "handlerDurationP95": $handlerDurationP95,
      "jsonParseDurationP95": $jsonParseDurationP95,
      "batchMessagesP95": $batchMessagesP95
    }' > "$gate_file"
}

collect_room_partition_state_dump() {
  local suffix="$1"
  local output_file="$RESULT_ROOT/metrics/room-partition-state-$suffix.tsv"

  if ! command -v mysql >/dev/null 2>&1; then
    echo "mysql client not installed" > "$output_file"
    return 0
  fi

  mysql \
    --connect-timeout=5 \
    -h "$MYSQL_INTERNAL_IP" \
    -uopenchat \
    -popenchat \
    -D openchat \
    -B \
    -e "SELECT room_id, partition_count, version, status, draining_partitions, updated_at, updated_by FROM room_partition_state ORDER BY updated_at DESC, room_id;" \
    > "$output_file" 2>"$RESULT_ROOT/metrics/room-partition-state-$suffix.err" || true
}

json_array_to_sql_in_list() {
  jq -r '
    .[]?
    | select(type == "string" and length > 0)
    | select(test("^[A-Za-z0-9:_-]+$"))
  ' | sort -u | awk 'BEGIN { first = 1 } { if (!first) printf ","; printf "\047%s\047", $0; first = 0 }'
}

collect_reconnect_command_log_dump() {
  local label="$1"
  local safe_label="$${label//\'/}"
  local output_file="$RESULT_ROOT/metrics/reconnect-command-log-$safe_label.tsv"
  local handling_output_file="$RESULT_ROOT/metrics/reconnect-command-handling-log-$safe_label.tsv"

  if [ "$K6_RECONNECT_COMMAND_LOG_ENABLED" != "true" ]; then
    echo "disabled" > "$output_file"
    echo "disabled" > "$handling_output_file"
    return 0
  fi
  if ! command -v mysql >/dev/null 2>&1; then
    echo "mysql client not installed" > "$output_file"
    echo "mysql client not installed" > "$handling_output_file"
    return 0
  fi

  mysql \
    --connect-timeout=5 \
    -h "$MYSQL_INTERNAL_IP" \
    -uopenchat \
    -popenchat \
    -D openchat \
    -B \
    -e "SELECT command_id, operation_id, command_type, COALESCE(target_node_id, ''), publish_status, COALESCE(redis_receivers, ''), created_at, COALESCE(published_at, ''), COALESCE(failed_at, '') FROM reconnect_command_log ORDER BY created_at DESC, command_id LIMIT 200;" \
    > "$output_file" 2>"$RESULT_ROOT/metrics/reconnect-command-log-$safe_label.err" || true

  mysql \
    --connect-timeout=5 \
    -h "$MYSQL_INTERNAL_IP" \
    -uopenchat \
    -popenchat \
    -D openchat \
    -B \
    -e "SELECT command_id, handler_node_id, status, open_sessions_before, targeted_sessions, sent_sessions, failed_sessions, remaining_open_sessions, handled_at FROM reconnect_command_handling_log ORDER BY handled_at DESC, command_id, handler_node_id LIMIT 200;" \
    > "$handling_output_file" 2>"$RESULT_ROOT/metrics/reconnect-command-handling-log-$safe_label.err" || true
}

enrich_orchestrator_with_reconnect_command_log() {
  local label="$1"
  local orchestrator_output="$2"

  if [ "$K6_RECONNECT_COMMAND_LOG_ENABLED" != "true" ]; then
    return 0
  fi
  if ! jq -e . "$orchestrator_output" >/dev/null 2>&1; then
    return 0
  fi
  local expected_json
  expected_json="$(jq -c '.attemptedReconnectCommandIds // []' "$orchestrator_output")"
  local in_list
  in_list="$(printf '%s' "$expected_json" | json_array_to_sql_in_list)"

  local safe_label="$${label//\'/}"
  local rows_file="$RESULT_ROOT/metrics/reconnect-command-log-orchestrator-$safe_label.tsv"
  local err_file="$RESULT_ROOT/metrics/reconnect-command-log-orchestrator-$safe_label.err"
  local handling_rows_file="$RESULT_ROOT/metrics/reconnect-command-handling-log-orchestrator-$safe_label.tsv"
  local handling_err_file="$RESULT_ROOT/metrics/reconnect-command-handling-log-orchestrator-$safe_label.err"
  local collection_status="collected"
  local collection_error=""
  local delivery_collection_status="collected"
  local delivery_collection_error=""
  : > "$rows_file"
  : > "$err_file"
  : > "$handling_rows_file"
  : > "$handling_err_file"

  if ! command -v mysql >/dev/null 2>&1; then
    collection_status="mysql_unavailable"
    collection_error="mysql client is not installed"
    delivery_collection_status="mysql_unavailable"
    delivery_collection_error="mysql client is not installed"
  elif [ -z "$in_list" ]; then
    collection_status="no_expected_commands"
    delivery_collection_status="no_expected_commands"
  else
    if ! mysql \
      --connect-timeout=5 \
      -h "$MYSQL_INTERNAL_IP" \
      -uopenchat \
      -popenchat \
      -D openchat \
      -N -B \
      -e "SELECT command_id, operation_id, command_type, COALESCE(target_node_id, ''), publish_status, COALESCE(redis_receivers, ''), created_at, COALESCE(published_at, ''), COALESCE(failed_at, '') FROM reconnect_command_log WHERE command_id IN ($in_list) ORDER BY created_at, command_id;" \
      > "$rows_file" 2>"$err_file"; then
      collection_status="query_failed"
      collection_error="$(tr '\n' ' ' < "$err_file" | cut -c1-500)"
      delivery_collection_status="query_failed"
      delivery_collection_error="$collection_error"
      : > "$rows_file"
    elif ! mysql \
      --connect-timeout=5 \
      -h "$MYSQL_INTERNAL_IP" \
      -uopenchat \
      -popenchat \
      -D openchat \
      -N -B \
      -e "SELECT command_id, handler_node_id, status, open_sessions_before, targeted_sessions, sent_sessions, failed_sessions, remaining_open_sessions, handled_at FROM reconnect_command_handling_log WHERE command_id IN ($in_list) ORDER BY command_id, handler_node_id, handled_at;" \
      > "$handling_rows_file" 2>"$handling_err_file"; then
      delivery_collection_status="query_failed"
      delivery_collection_error="$(tr '\n' ' ' < "$handling_err_file" | cut -c1-500)"
      : > "$handling_rows_file"
    fi
  fi

  local records_json
  records_json="$(jq -Rn '
    [inputs
      | select(length > 0)
      | split("\t")
      | {
          commandId: .[0],
          operationId: .[1],
          commandType: .[2],
          targetNodeId: (if .[3] == "" then null else .[3] end),
          publishStatus: .[4],
          redisReceivers: (if .[5] == "" then null else (.[5] | tonumber) end),
          createdAt: (.[6] | tonumber),
          publishedAt: (if .[7] == "" then null else (.[7] | tonumber) end),
          failedAt: (if .[8] == "" then null else (.[8] | tonumber) end)
        }
    ]
  ' < "$rows_file")"

  local handling_records_json
  handling_records_json="$(jq -Rn '
    [inputs
      | select(length > 0)
      | split("\t")
      | {
          commandId: .[0],
          handlerNodeId: .[1],
          status: .[2],
          openSessionsBefore: (.[3] | tonumber),
          targetedSessions: (.[4] | tonumber),
          sentSessions: (.[5] | tonumber),
          failedSessions: (.[6] | tonumber),
          remainingOpenSessions: (.[7] | tonumber),
          handledAt: (if .[8] == "" then null else (.[8] | tonumber) end)
        }
    ]
  ' < "$handling_rows_file")"

  local tmp_output="$orchestrator_output.tmp"
  jq --argjson expected "$expected_json" \
    --argjson records "$records_json" \
    --argjson handlingRecords "$handling_records_json" \
    --arg collectionStatus "$collection_status" \
    --arg deliveryCollectionStatus "$delivery_collection_status" \
    --arg collectionError "$collection_error" \
    --arg deliveryCollectionError "$delivery_collection_error" '
    def unique_nonempty:
      map(select(. != null and . != "")) | unique;
    def delivery_for($record; $handlers):
      (if (($record.targetNodeId // "") == "") then [] else [$record.targetNodeId] end) as $expectedHandlers
      | ($expectedHandlers | length > 0) as $strictEligible
      | ($handlers | map(.handlerNodeId) | unique_nonempty) as $actualHandlers
      | ($expectedHandlers | map(select(($actualHandlers | index(.)) == null))) as $missingHandlers
      | ($handlers
          | map(select(.status == "PARTIAL" or .status == "FAILED") | .handlerNodeId)
          | unique_nonempty) as $failedHandlers
      | {
          strictEligible: $strictEligible,
          strictEligibilityReason: (if $strictEligible then "target_node" else "missing_target_node" end),
          complete: ($record.publishStatus == "SUCCEEDED" and ($missingHandlers | length) == 0 and ($failedHandlers | length) == 0),
          expectedHandlers: $expectedHandlers,
          actualHandlers: $actualHandlers,
          missingHandlers: $missingHandlers,
          failedHandlers: $failedHandlers,
          handlingRecords: $handlers
        };
    ($records | map(.commandId)) as $recordedRaw
    | ($recordedRaw | unique) as $recorded
    | (if $collectionStatus == "collected" then ($expected | map(select(($recorded | index(.)) == null))) else [] end) as $missing
    | ($recordedRaw | group_by(.) | map(select(length > 1) | .[0])) as $duplicates
    | ($handlingRecords
        | group_by(.commandId)
        | map({key: .[0].commandId, value: .})
        | from_entries) as $handlingByCommand
    | ($records
        | map(. as $record
          | ($handlingByCommand[$record.commandId] // []) as $handlers
          | . + {deliveryEvidence: delivery_for($record; $handlers)})) as $recordsWithDelivery
    | ($recordsWithDelivery
        | map(.deliveryEvidence.missingHandlers[])
        | unique_nonempty) as $missingHandlers
    | ($recordsWithDelivery
        | map(.deliveryEvidence.failedHandlers[])
        | unique_nonempty) as $failedHandlers
    | .durableReconnectCommandLog = {
        enabled: true,
        mode: "audit_only",
        contractVersion: "openchat.reconnect-command-log.v1",
        collectionStatus: $collectionStatus,
        collectionError: (if $collectionError == "" then null else $collectionError end),
        expectedCommandIds: $expected,
        recordedCommandIds: $recorded,
        missingCommandIds: $missing,
        duplicateCommandIds: $duplicates,
        recordCount: ($records | length),
        lastRecordedCommandId: ($recordedRaw | last // null),
        records: $recordsWithDelivery,
        deliveryEvidence: {
          enabled: true,
          mode: "audit_only",
          collectionStatus: $deliveryCollectionStatus,
          collectionError: (if $deliveryCollectionError == "" then null else $deliveryCollectionError end),
          complete: (($missing | length) == 0 and ($recordsWithDelivery | length) > 0 and ($recordsWithDelivery | map(.deliveryEvidence.complete) | all)),
          commandCount: ($recordsWithDelivery | length),
          strictEligibleCommandCount: ($recordsWithDelivery | map(select(.deliveryEvidence.strictEligible)) | length),
          missingHandlers: $missingHandlers,
          failedHandlers: $failedHandlers
        }
      }
  ' "$orchestrator_output" > "$tmp_output" 2>/dev/null && mv "$tmp_output" "$orchestrator_output" || rm -f "$tmp_output"
}

get_workload_summary_token() {
  if [ -n "$${WORKLOAD_SUMMARY_TOKEN:-}" ]; then
    printf '%s' "$WORKLOAD_SUMMARY_TOKEN"
    return 0
  fi
  local login_body
  local login_response
  login_body=$(jq -nc \
    --arg userId "workload-summary-$RUN_ID" \
    --arg nickname "WorkloadSummary" \
    '{userId: $userId, nickname: $nickname}')
  login_response=$(curl --max-time 10 -sf \
    -H "Content-Type: application/json" \
    -d "$login_body" \
    "$BASE_URL/api/auth/login" || true)
  WORKLOAD_SUMMARY_TOKEN=$(printf '%s' "$login_response" | jq -r '.token // empty')
  printf '%s' "$WORKLOAD_SUMMARY_TOKEN"
}

collect_realtime_workload_snapshot() {
  local suffix="$1"
  if [ "$REALTIME_WORKLOAD_SUMMARY_ENABLED" != "true" ]; then
    echo "{\"enabled\":false,\"skipped\":true}" > "$RESULT_ROOT/metrics/realtime-workload-summary-$suffix.json"
    echo "{\"enabled\":false,\"skipped\":true}" > "$RESULT_ROOT/metrics/realtime-workload-recommendations-$suffix.json"
    collect_room_partition_state_dump "$suffix"
    return 0
  fi

  local workload_token
  workload_token=$(get_workload_summary_token || true)
  if [ -n "$workload_token" ]; then
    curl --max-time 10 -sf -H "Authorization: Bearer $workload_token" "$BASE_URL/api/internal/realtime/workload/summary" > "$RESULT_ROOT/metrics/realtime-workload-summary-$suffix.json" || true
    curl --max-time 10 -sf -H "Authorization: Bearer $workload_token" "$BASE_URL/api/internal/realtime/workload/recommendations" > "$RESULT_ROOT/metrics/realtime-workload-recommendations-$suffix.json" || true
  fi
  collect_room_partition_state_dump "$suffix"
}

collect_assignment_snapshot() {
  local suffix="$1"
  local token
  token=$(get_workload_summary_token || true)
  if [ -z "$token" ]; then
    echo "{\"error\":\"token unavailable\"}" > "$RESULT_ROOT/metrics/room-partition-nodes-$suffix.json"
    echo "{\"error\":\"token unavailable\"}" > "$RESULT_ROOT/metrics/room-partition-assignments-$suffix.json"
    return 0
  fi

  curl --max-time 10 -sf \
    -H "Authorization: Bearer $token" \
    "$BASE_URL/api/internal/room-partition/nodes" \
    > "$RESULT_ROOT/metrics/room-partition-nodes-$suffix.json" || true
  curl --max-time 10 -sf \
    -H "Authorization: Bearer $token" \
    "$BASE_URL/api/internal/room-partition/assignments?partitionCount=$K6_ASSIGNMENT_PREFLIGHT_PARTITION_COUNT" \
    > "$RESULT_ROOT/metrics/room-partition-assignments-$suffix.json" || true
}

collect_node_drain_status_snapshot() {
  local target_node="$1"
  local suffix="$2"
  local token="$3"
  if [ -z "$target_node" ] || [ "$target_node" = "null" ]; then
    echo "{\"error\":\"target node unavailable\"}" > "$RESULT_ROOT/metrics/node-drain-status-$suffix.json"
    return 0
  fi
  if [ -z "$token" ]; then
    token=$(get_workload_summary_token || true)
  fi
  if [ -z "$token" ]; then
    echo "{\"error\":\"token unavailable\",\"targetNode\":\"$target_node\"}" > "$RESULT_ROOT/metrics/node-drain-status-$suffix.json"
    return 0
  fi

  curl --max-time 10 -sf \
    -H "Authorization: Bearer $token" \
    "$BASE_URL/api/internal/room-partition/nodes/$target_node/drain/status" \
    > "$RESULT_ROOT/metrics/node-drain-status-$suffix.json" || true
}

assert_target_node_removed_after_stop() {
  local label="$1"
  local target_node="$2"
  local summary_file="$RESULT_ROOT/metrics/gcp-node-termination-target-removed-$label.json"

  for attempt in $(seq 1 15); do
    local suffix="gcp-node-termination-target-removed-$label-$attempt"
    collect_assignment_snapshot "$suffix"

    local nodes_file="$RESULT_ROOT/metrics/room-partition-nodes-$suffix.json"
    local assignments_file="$RESULT_ROOT/metrics/room-partition-assignments-$suffix.json"
    local active_count
    local owner_count
    local ready_count
    active_count=$(jq -r --arg node "$target_node" '[ (.activeNodes // [])[] | select(.nodeId == $node) ] | length' "$nodes_file" 2>/dev/null || echo "parse_failed")
    owner_count=$(jq -r --arg node "$target_node" '[ (.assignments // {})[] | select(.nodeId == $node) ] | length' "$assignments_file" 2>/dev/null || echo "parse_failed")
    ready_count=$(jq -r '[ (.assignments // {})[] | select(.ready == true) ] | length' "$assignments_file" 2>/dev/null || echo "parse_failed")

    jq -nc \
      --arg targetNode "$target_node" \
      --argjson attempt "$attempt" \
      --arg activeCount "$active_count" \
      --arg ownerCount "$owner_count" \
      --arg readyCount "$ready_count" \
      '{
        targetNode: $targetNode,
        attempt: $attempt,
        activeCount: $activeCount,
        ownerCount: $ownerCount,
        readyCount: $readyCount,
        removed: ($activeCount == "0" and $ownerCount == "0")
      }' > "$summary_file" || true

    if [ "$active_count" = "0" ] && [ "$owner_count" = "0" ]; then
      echo "[k6] target node removed from active registry and assignments target_node=$target_node attempt=$attempt"
      return 0
    fi
    sleep 2
  done

  echo "[k6] target node still appears active or assigned after stop target_node=$target_node" >&2
  return 1
}

run_gcp_node_termination_post_stop_probe() {
  local label="$1"
  local target_node="$2"
  if [ "$K6_GCP_NODE_TERMINATION_POST_STOP_PROBE_ENABLED" != "true" ]; then
    return 0
  fi

  local probe_vus="$K6_GCP_NODE_TERMINATION_POST_STOP_PROBE_VUS"
  local probe_duration="$K6_GCP_NODE_TERMINATION_POST_STOP_PROBE_DURATION_SECONDS"
  local probe_label="$PROFILE-post-stop-$label"
  local probe_output_dir="$RESULT_ROOT/k6/$PROFILE/post-stop"
  mkdir -p "$probe_output_dir"

  echo "[k6] running post-stop probe target_node=$target_node label=$probe_label vus=$probe_vus duration=$probe_duration"
  set +e
  k6 run \
    --summary-export "$probe_output_dir/$label-summary.json" \
    -e BASE_URL="$BASE_URL" \
    -e WS_BASE_URL="$WS_BASE_URL" \
    -e TARGET_VUS="$probe_vus" \
    -e TOTAL_TARGET_VUS="$probe_vus" \
    -e TEST_LABEL="$probe_label" \
    -e SEND_INTERVAL_MS="500" \
    -e CHAT_DURATION_SECONDS="$probe_duration" \
    -e K6_WS_SEND_STOP_AFTER_SECONDS="$probe_duration" \
    -e K6_CHAT_ACK_P95_THRESHOLD_MS="0" \
    -e K6_VISIBLE_FRESHNESS_P95_THRESHOLD_MS="$K6_VISIBLE_FRESHNESS_P95_THRESHOLD_MS" \
    -e K6_VISIBLE_LATEST_FRESHNESS_P95_THRESHOLD_MS="0" \
    -e K6_ASSIGNMENT_PREFLIGHT_ENABLED="true" \
    -e K6_ASSIGNMENT_PREFLIGHT_PARTITION_COUNT="$K6_ASSIGNMENT_PREFLIGHT_PARTITION_COUNT" \
    -e K6_ASSIGNMENT_PREFLIGHT_EXPECTED_NODES="1" \
    -e K6_ASSIGNMENT_PREFLIGHT_TIMEOUT_SECONDS="$K6_ASSIGNMENT_PREFLIGHT_TIMEOUT_SECONDS" \
    -e CONNECT_RAMP_SECONDS="3" \
    -e HOT_ROOMS="1" \
    -e VUS_PER_ROOM="$probe_vus" \
    -e ROOM_INDEX_OFFSET="0" \
    -e VU_INDEX_OFFSET="0" \
    -e K6_WORKER_INDEX="1" \
    -e K6_WORKER_COUNT="1" \
    -e SHARED_ROOM_MODE="false" \
    -e K6_SENDER_RATIO="0.80" \
    -e K6_OBSERVER_RATIO="0.20" \
    -e K6_VALIDATOR_RATIO="0" \
    -e OBSERVER_SEND_INTERVAL_MS="0" \
    -e ACTIVE_HEARTBEAT_INTERVAL_MS="$ACTIVE_HEARTBEAT_INTERVAL_MS" \
    -e PASSIVE_SETTLE_MS="$PASSIVE_SETTLE_MS" \
    -e MIXED_HOT_ROOM_COUNT="1" \
    -e MIXED_HOT_ROOM_VUS="$probe_vus" \
    -e MIXED_HOT_ACTIVE_RATIO="1.0" \
    -e MIXED_HOT_SEND_INTERVAL_MS="500" \
    -e MIXED_LARGE_ROOM_COUNT="0" \
    -e MIXED_LARGE_ROOM_VUS="0" \
    -e MIXED_LARGE_ACTIVE_RATIO="0" \
    -e MIXED_LARGE_SEND_INTERVAL_MS="5000" \
    -e MIXED_MEDIUM_ROOM_COUNT="0" \
    -e MIXED_MEDIUM_ROOM_VUS="0" \
    -e MIXED_MEDIUM_ACTIVE_RATIO="0" \
    -e MIXED_MEDIUM_SEND_INTERVAL_MS="5000" \
    -e MIXED_SMALL_ROOM_COUNT="0" \
    -e MIXED_SMALL_ROOM_VUS="0" \
    -e MIXED_SMALL_ACTIVE_RATIO="0" \
    -e MIXED_SMALL_SEND_INTERVAL_MS="5000" \
    -e K6_COUNTER_FLUSH_INTERVAL_MS="1000" \
    -e K6_VISIBLE_FRESHNESS_SAMPLE_EVERY="1" \
    "$SCENARIO" 2>&1 | tee "$probe_output_dir/$label.log"
  local probe_status=$${PIPESTATUS[0]}
  set -e

  echo "$probe_status" > "$probe_output_dir/$label-exit-code.txt"
  collect_db_message_count "$probe_label" "$probe_output_dir"
  write_post_stop_probe_result \
    "$label" \
    "$target_node" \
    "$probe_status" \
    "$probe_output_dir/$label-summary.json" \
    "$probe_output_dir/$probe_label-db-message-count.json" \
    "$RESULT_ROOT/metrics/post-stop-probe-$label.json"
  collect_assignment_snapshot "gcp-node-termination-post-stop-probe-$label"
  collect_node_drain_status_snapshot "$target_node" "gcp-node-termination-post-stop-probe-$label" ""
  return "$probe_status"
}

trigger_node_drain_during_run() {
  local label="$1"
  local output_file="$RESULT_ROOT/metrics/node-drain-$label.json"
  if [ "$K6_NODE_DRAIN_ENABLED" != "true" ] || [ "$K6_IS_COORDINATOR" != "true" ]; then
    return 0
  fi

  sleep "$K6_NODE_DRAIN_AFTER_SECONDS"
  collect_assignment_snapshot "node-drain-before-$label"

  local token
  token=$(get_workload_summary_token || true)
  if [ -z "$token" ]; then
    echo "{\"status\":\"skipped\",\"reason\":\"token unavailable\"}" > "$output_file"
    return 1
  fi

  local nodes_file="$RESULT_ROOT/metrics/room-partition-nodes-node-drain-before-$label.json"
  local target_node
  target_node=$(jq -r '
    . as $root
    | [($root.activeNodes // [])[] | select((.openSessions // 0) > 0)]
    | sort_by(.openSessions // 0)
    | reverse
    | .[0].nodeId // (($root.activeNodes // [])[0].nodeId // "")
  ' "$nodes_file" 2>/dev/null || true)

  if [ -z "$target_node" ] || [ "$target_node" = "null" ]; then
    echo "{\"status\":\"skipped\",\"reason\":\"no active target node\"}" > "$output_file"
    return 1
  fi

  if [ "$K6_NODE_DRAIN_ORCHESTRATOR_ENABLED" = "true" ]; then
    echo "[k6] triggering node drain orchestrator target_node=$target_node label=$label"
    local orchestrator_output="$RESULT_ROOT/metrics/node-drain-orchestrator-$label.json"
    local orchestrator_stdout="$RESULT_ROOT/metrics/node-drain-orchestrator-stdout-$label.json"
    chmod +x "$WORKDIR/scripts/openchat-node-drain-orchestrate.sh" || true

    set +e
    "$WORKDIR/scripts/openchat-node-drain-orchestrate.sh" \
      --base-url "$BASE_URL" \
      --node-id "$target_node" \
      --token "$token" \
      --timeout-seconds "$K6_NODE_DRAIN_ORCHESTRATOR_TIMEOUT_SECONDS" \
      --poll-interval-ms "$K6_NODE_DRAIN_ORCHESTRATOR_POLL_INTERVAL_MS" \
      --reconnect-limit "$K6_NODE_DRAIN_LIMIT" \
      --reconnect-retry-after-ms "$K6_NODE_DRAIN_RETRY_AFTER_MS" \
      --max-reconnect-attempts "$K6_NODE_DRAIN_ORCHESTRATOR_MAX_RECONNECT_ATTEMPTS" \
      --output "$orchestrator_output" \
      > "$orchestrator_stdout"
    local orchestrator_status=$?
    set -e

    collect_assignment_snapshot "node-drain-after-orchestrator-$label"
    collect_node_drain_status_snapshot "$target_node" "node-drain-after-orchestrator-$label" "$token"
    collect_reconnect_command_log_dump "node-drain-after-orchestrator-$label"
    enrich_orchestrator_with_reconnect_command_log "$label" "$orchestrator_output"

    if jq -e . "$orchestrator_output" >/dev/null 2>&1; then
      jq -nc \
        --arg targetNode "$target_node" \
        --argjson orchestrator "$(cat "$orchestrator_output")" \
        '{
          targetNode: $targetNode,
          complete: ($orchestrator.terminationAllowed == true),
          status: $orchestrator.result,
          lastDrainStatus: $orchestrator.lastStatus,
          lastNextAction: $orchestrator.lastNextAction,
          lastCommandId: $orchestrator.lastCommandId,
          lastReconnectCommandId: $orchestrator.lastReconnectCommandId,
          reconnectCommandIds: ($orchestrator.reconnectCommandIds // []),
          attemptedReconnectCommandIds: ($orchestrator.attemptedReconnectCommandIds // []),
          terminationAllowed: $orchestrator.terminationAllowed,
          orchestrator: $orchestrator
        }' > "$output_file" 2>/dev/null || cp "$orchestrator_output" "$output_file"
    else
      echo "{\"targetNode\":\"$target_node\",\"complete\":false,\"status\":\"orchestrator_output_missing\",\"exitCode\":$orchestrator_status}" > "$output_file"
    fi

    if [ "$orchestrator_status" -ne 0 ]; then
      return "$orchestrator_status"
    fi

    if [ "$K6_NODE_TERMINATION_DECISION_ENABLED" = "true" ]; then
      echo "[k6] validating node termination decision target_node=$target_node label=$label"
      local decision_output="$RESULT_ROOT/metrics/node-termination-decision-$label.json"
      local decision_stdout="$RESULT_ROOT/metrics/node-termination-decision-stdout-$label.json"
      chmod +x "$WORKDIR/scripts/openchat-node-termination-decision.sh" || true
      local decision_args=(
        --input "$orchestrator_output"
        --node-id "$target_node"
        --output "$decision_output"
      )
      if [ "$K6_NODE_TERMINATION_STRICT_DELIVERY_EVIDENCE_ENABLED" = "true" ]; then
        decision_args+=(--strict-delivery-evidence)
      fi

      set +e
      "$WORKDIR/scripts/openchat-node-termination-decision.sh" "$${decision_args[@]}" > "$decision_stdout"
      local decision_status=$?
      set -e

      if jq -e . "$decision_output" >/dev/null 2>&1 && jq -e . "$output_file" >/dev/null 2>&1; then
        local output_tmp="$output_file.tmp"
        jq --argjson decision "$(cat "$decision_output")" \
          '. + {
            terminationDecision: $decision,
            terminationDecisionReady: ($decision.result == "ready"),
            terminationDecisionRecommendedAction: $decision.recommendedAction
          }' "$output_file" > "$output_tmp" 2>/dev/null && mv "$output_tmp" "$output_file" || rm -f "$output_tmp"
      fi

      if [ "$decision_status" -ne 0 ]; then
        echo "[k6] node termination decision failed target_node=$target_node status=$decision_status" >&2
        return "$decision_status"
      fi

      if [ "$K6_GCP_NODE_TERMINATION_ADAPTER_ENABLED" = "true" ]; then
        echo "[k6] stopping drained GCP node target_node=$target_node label=$label mode=$K6_GCP_NODE_TERMINATION_ADAPTER_MODE"
        local gcp_termination_output="$RESULT_ROOT/metrics/gcp-node-termination-$label.json"
        local gcp_termination_stdout="$RESULT_ROOT/metrics/gcp-node-termination-stdout-$label.json"
        chmod +x "$WORKDIR/scripts/openchat-gcp-node-terminate.sh" || true

        set +e
        "$WORKDIR/scripts/openchat-gcp-node-terminate.sh" \
          --decision "$decision_output" \
          --project "$PROJECT_ID" \
          --zone "$ZONE" \
          --run-id "$RUN_ID" \
          --node-id "$target_node" \
          --mode "$K6_GCP_NODE_TERMINATION_ADAPTER_MODE" \
          --output "$gcp_termination_output" \
          > "$gcp_termination_stdout"
        local gcp_termination_status=$?
        set -e

        collect_assignment_snapshot "gcp-node-termination-after-$label"
        collect_node_drain_status_snapshot "$target_node" "gcp-node-termination-after-$label" "$token"

        if jq -e . "$gcp_termination_output" >/dev/null 2>&1 && jq -e . "$output_file" >/dev/null 2>&1; then
          local output_tmp="$output_file.tmp"
          jq --argjson gcpTermination "$(cat "$gcp_termination_output")" \
            '. + {
              gcpNodeTermination: $gcpTermination,
              gcpNodeTerminationResult: $gcpTermination.result,
              gcpNodeTerminationPerformed: $gcpTermination.terminationPerformed
            }' "$output_file" > "$output_tmp" 2>/dev/null && mv "$output_tmp" "$output_file" || rm -f "$output_tmp"
        fi

        if [ "$gcp_termination_status" -ne 0 ]; then
          echo "[k6] GCP node termination adapter failed target_node=$target_node status=$gcp_termination_status" >&2
          return "$gcp_termination_status"
        fi

        if [ "$K6_GCP_NODE_TERMINATION_ADAPTER_MODE" = "stop" ]; then
          assert_target_node_removed_after_stop "$label" "$target_node" || return 1

          local post_stop_probe_status=0
          run_gcp_node_termination_post_stop_probe "$label" "$target_node" || post_stop_probe_status=$?
          if jq -e . "$output_file" >/dev/null 2>&1; then
            local output_tmp="$output_file.tmp"
            jq --argjson postStopProbeExitCode "$post_stop_probe_status" \
              '. + {
                postStopProbe: {
                  enabled: true,
                  exitCode: $postStopProbeExitCode
                }
              }' "$output_file" > "$output_tmp" 2>/dev/null && mv "$output_tmp" "$output_file" || rm -f "$output_tmp"
          fi
          if [ "$post_stop_probe_status" -ne 0 ]; then
            echo "[k6] post-stop probe failed target_node=$target_node status=$post_stop_probe_status" >&2
            return "$post_stop_probe_status"
          fi
        fi
      fi
    fi

    return 0
  fi

  echo "[k6] triggering node drain target_node=$target_node label=$label"
  local drain_response
  drain_response=$(curl --max-time 30 -sS \
    -X POST \
    -H "Authorization: Bearer $token" \
    "$BASE_URL/api/internal/room-partition/nodes/$target_node/drain?limit=$K6_NODE_DRAIN_LIMIT&retryAfterMs=$K6_NODE_DRAIN_RETRY_AFTER_MS" || true)
  printf '%s' "$drain_response" > "$RESULT_ROOT/metrics/node-drain-response-$label.json"
  local drain_status
  drain_status=$(printf '%s' "$drain_response" | jq -r '.status // "missing_status"' 2>/dev/null || echo "parse_failed")
  if [ "$drain_status" != "reconnect_published" ] && [ "$drain_status" != "complete" ]; then
    echo "[k6] node drain request failed target_node=$target_node status=$drain_status response=$drain_response" >&2
    echo "{\"targetNode\":\"$target_node\",\"complete\":false,\"status\":\"$drain_status\"}" > "$output_file"
    return 1
  fi
  collect_assignment_snapshot "node-drain-after-request-$label"
  collect_node_drain_status_snapshot "$target_node" "node-drain-after-request-$label" "$token"

  local complete="false"
  local last_sessions="unknown"
  local last_still_owner="unknown"
  local last_ready_count="unknown"
  local last_drain_status="unknown"
  local last_next_action="unknown"
  for attempt in $(seq 1 90); do
    sleep 2
    collect_assignment_snapshot "node-drain-progress-$label-$attempt"
    collect_node_drain_status_snapshot "$target_node" "node-drain-progress-$label-$attempt" "$token"
    local sessions
    local still_owner
    local ready_count
    local status_snapshot
    local next_action
    sessions=$(jq -r --arg node "$target_node" '[ (.nodes // [])[] | select(.nodeId == $node) | (.openSessions // 0) ] | max // 0' "$RESULT_ROOT/metrics/room-partition-nodes-node-drain-progress-$label-$attempt.json" 2>/dev/null || echo "0")
    still_owner=$(jq -r --arg node "$target_node" '[ (.assignments // {})[] | select(.nodeId == $node) ] | length' "$RESULT_ROOT/metrics/room-partition-assignments-node-drain-progress-$label-$attempt.json" 2>/dev/null || echo "0")
    ready_count=$(jq -r '[ (.assignments // {})[] | select(.ready == true) ] | length' "$RESULT_ROOT/metrics/room-partition-assignments-node-drain-progress-$label-$attempt.json" 2>/dev/null || echo "0")
    status_snapshot=$(jq -r '.status // "missing_status"' "$RESULT_ROOT/metrics/node-drain-status-node-drain-progress-$label-$attempt.json" 2>/dev/null || echo "parse_failed")
    next_action=$(jq -r '.nextAction // "missing_next_action"' "$RESULT_ROOT/metrics/node-drain-status-node-drain-progress-$label-$attempt.json" 2>/dev/null || echo "parse_failed")
    last_sessions="$sessions"
    last_still_owner="$still_owner"
    last_ready_count="$ready_count"
    last_drain_status="$status_snapshot"
    last_next_action="$next_action"
    if [ "$sessions" = "0" ] && [ "$still_owner" = "0" ] && [ "$ready_count" -ge "$K6_ASSIGNMENT_PREFLIGHT_PARTITION_COUNT" ]; then
      complete="true"
      break
    fi
  done

  if [ "$complete" != "true" ]; then
    echo "[k6] node drain did not complete target_node=$target_node label=$label" >&2
    jq -nc \
      --arg targetNode "$target_node" \
      --arg status "timeout" \
      --arg sessions "$last_sessions" \
      --arg stillOwner "$last_still_owner" \
      --arg readyCount "$last_ready_count" \
      --arg drainStatus "$last_drain_status" \
      --arg nextAction "$last_next_action" \
      '{targetNode: $targetNode, complete: false, status: $status, lastSessions: $sessions, lastStillOwner: $stillOwner, lastReadyCount: $readyCount, lastDrainStatus: $drainStatus, lastNextAction: $nextAction}' \
      > "$output_file" 2>/dev/null || echo "{\"targetNode\":\"$target_node\",\"complete\":false,\"status\":\"timeout\"}" > "$output_file"
    return 1
  fi

  jq -nc \
    --arg targetNode "$target_node" \
    --arg complete "$complete" \
    --arg drainStatus "$last_drain_status" \
    --arg nextAction "$last_next_action" \
    --argjson response "$${drain_response:-null}" \
    '{targetNode: $targetNode, complete: ($complete == "true"), lastDrainStatus: $drainStatus, lastNextAction: $nextAction, response: $response}' \
    > "$output_file" 2>/dev/null || echo "{\"targetNode\":\"$target_node\",\"complete\":$complete}" > "$output_file"
}

collect_workload_snapshots_during_run() {
  local label="$1"
  local interval_seconds=15
  local max_seconds=$((CONNECT_RAMP_SECONDS + CHAT_DURATION_SECONDS + 90))
  local end_at=$((SECONDS + max_seconds))
  local index=1

  while [ "$SECONDS" -lt "$end_at" ]; do
    sleep "$interval_seconds"
    collect_realtime_workload_snapshot "during-$label-$index"
    index=$((index + 1))
  done
}

trigger_rolling_restart_during_run() {
  local label="$1"
  local output_file="$RESULT_ROOT/metrics/rolling-restart-$label.json"
  if [ "$K6_ROLLING_RESTART_ENABLED" != "true" ] || [ "$K6_IS_COORDINATOR" != "true" ]; then
    return 0
  fi

  sleep "$K6_NODE_DRAIN_AFTER_SECONDS"
  collect_assignment_snapshot "rolling-restart-before-$label"

  local token
  token=$(get_workload_summary_token || true)
  if [ -z "$token" ]; then
    echo "{\"status\":\"skipped\",\"reason\":\"token unavailable\"}" > "$output_file"
    return 1
  fi

  echo "[k6] triggering rolling restart label=$label targets=$K6_ROLLING_RESTART_TARGET_COUNT min_active=$K6_ROLLING_RESTART_MIN_ACTIVE_NODES mode=$K6_GCP_NODE_TERMINATION_ADAPTER_MODE"
  local rolling_stdout="$RESULT_ROOT/metrics/rolling-restart-stdout-$label.json"
  local rolling_enricher="$RESULT_ROOT/metrics/rolling-restart-enricher-$label.sh"
  chmod +x "$WORKDIR/scripts/openchat-rolling-restart-orchestrate.sh" || true
  {
    declare -f json_array_to_sql_in_list
    declare -f enrich_orchestrator_with_reconnect_command_log
    printf '%s\n' 'enrich_orchestrator_with_reconnect_command_log "$1" "$2"'
  } > "$rolling_enricher"
  chmod +x "$rolling_enricher"
  export K6_RECONNECT_COMMAND_LOG_ENABLED MYSQL_INTERNAL_IP RESULT_ROOT

  local rolling_args=(
    --base-url "$BASE_URL"
    --token "$token"
    --project "$PROJECT_ID"
    --zone "$ZONE"
    --run-id "$RUN_ID"
    --target-count "$K6_ROLLING_RESTART_TARGET_COUNT"
    --min-active-nodes "$K6_ROLLING_RESTART_MIN_ACTIVE_NODES"
    --interval-seconds "$K6_ROLLING_RESTART_INTERVAL_SECONDS"
    --gcp-mode "$K6_GCP_NODE_TERMINATION_ADAPTER_MODE"
    --partition-count "$K6_ASSIGNMENT_PREFLIGHT_PARTITION_COUNT"
    --timeout-seconds "$K6_NODE_DRAIN_ORCHESTRATOR_TIMEOUT_SECONDS"
    --poll-interval-ms "$K6_NODE_DRAIN_ORCHESTRATOR_POLL_INTERVAL_MS"
    --reconnect-limit "$K6_NODE_DRAIN_LIMIT"
    --reconnect-retry-after-ms "$K6_NODE_DRAIN_RETRY_AFTER_MS"
    --max-reconnect-attempts "$K6_NODE_DRAIN_ORCHESTRATOR_MAX_RECONNECT_ATTEMPTS"
    --output "$output_file"
  )
  if [ "$K6_NODE_TERMINATION_STRICT_DELIVERY_EVIDENCE_ENABLED" = "true" ]; then
    rolling_args+=(--strict-delivery-evidence)
  fi

  set +e
  OPENCHAT_ROLLING_RESTART_DRAIN_ENRICHER="$rolling_enricher" \
    "$WORKDIR/scripts/openchat-rolling-restart-orchestrate.sh" "$${rolling_args[@]}" > "$rolling_stdout"
  local rolling_status=$?
  set -e

  collect_assignment_snapshot "rolling-restart-after-$label"
  collect_reconnect_command_log_dump "rolling-restart-after-$label"
  if jq -e . "$output_file" >/dev/null 2>&1; then
    jq -r '.steps[]?.nodeId // empty' "$output_file" | while read -r stopped_node; do
      if [ -n "$stopped_node" ]; then
        collect_node_drain_status_snapshot "$stopped_node" "rolling-restart-after-$label-$stopped_node" "$token"
      fi
    done
  fi

  if [ "$rolling_status" -ne 0 ]; then
    echo "[k6] rolling restart failed label=$label status=$rolling_status" >&2
    return "$rolling_status"
  fi

  if [ "$K6_GCP_NODE_TERMINATION_ADAPTER_MODE" = "stop" ] && [ "$K6_GCP_NODE_TERMINATION_POST_STOP_PROBE_ENABLED" = "true" ]; then
    local post_stop_probe_status=0
    if jq -e . "$output_file" >/dev/null 2>&1; then
      jq -r '.steps[]?.nodeId // empty' "$output_file" | while read -r stopped_node; do
        if [ -n "$stopped_node" ]; then
          local stopped_node_suffix="$${stopped_node##*-}"
          run_gcp_node_termination_post_stop_probe "rr-$label-n$stopped_node_suffix" "$stopped_node" || exit $?
        fi
      done || post_stop_probe_status=$?
    fi
    if jq -e . "$output_file" >/dev/null 2>&1; then
      local output_tmp="$output_file.tmp"
      jq --argjson postStopProbeExitCode "$post_stop_probe_status" \
        '. + {
          postStopProbe: {
            enabled: true,
            exitCode: $postStopProbeExitCode
          }
        }' "$output_file" > "$output_tmp" 2>/dev/null && mv "$output_tmp" "$output_file" || rm -f "$output_tmp"
    fi
    if [ "$post_stop_probe_status" -ne 0 ]; then
      echo "[k6] rolling restart post-stop probe failed label=$label status=$post_stop_probe_status" >&2
      return "$post_stop_probe_status"
    fi
  fi
}

collect_app_snapshots() {
  local suffix="$1"
  curl --max-time 10 -sf "$BASE_URL/actuator/health" > "$RESULT_ROOT/metrics/lb-health-$suffix.json" || true
  curl --max-time 10 -sf "$BASE_URL/actuator/prometheus" > "$RESULT_ROOT/metrics/lb-prometheus-$suffix.txt" || true
  collect_realtime_workload_snapshot "$suffix"

  app_index=1
  for app_ip in $APP_INTERNAL_IPS; do
    curl --max-time 10 -sf "http://$app_ip:8080/actuator/health" > "$RESULT_ROOT/metrics/app-$${app_index}-health-$suffix.json" || true
    curl --max-time 10 -sf "http://$app_ip:8080/actuator/prometheus" > "$RESULT_ROOT/metrics/app-$${app_index}-prometheus-$suffix.txt" || true
    app_index=$((app_index + 1))
  done
}

create_shared_room() {
  local admin_id="shared-room-admin-$RUN_ID"
  local admin_nickname="SharedAdmin$K6_WORKER_INDEX"
  local login_body
  local login_response
  local token
  local room_body
  local room_response
  local room_id

  login_body=$(jq -nc \
    --arg userId "$admin_id" \
    --arg nickname "$admin_nickname" \
    '{userId: $userId, nickname: $nickname}')
  login_response=$(curl --max-time 10 -sf \
    -H "Content-Type: application/json" \
    -d "$login_body" \
    "$BASE_URL/api/auth/login" || true)
  token=$(printf '%s' "$login_response" | jq -r '.token // empty')
  if [ -z "$token" ]; then
    echo "[k6] shared room admin login failed response=$login_response" >&2
    return 1
  fi

  room_body=$(jq -nc \
    --arg name "shared-hr-$RUN_ID" \
    '{name: $name, description: "Shared k6 hot room load test", category: "loadtest", requiresApproval: false}')
  room_response=$(curl --max-time 10 -sf \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -d "$room_body" \
    "$BASE_URL/api/rooms" || true)
  room_id=$(printf '%s' "$room_response" | jq -r '.id // .data.id // empty')
  if [ -z "$room_id" ]; then
    echo "[k6] shared room create failed response=$room_response" >&2
    return 1
  fi

  SHARED_ROOM_ID="$room_id"
  jq -nc \
    --arg runId "$RUN_ID" \
    --arg roomId "$SHARED_ROOM_ID" \
    --arg createdAt "$(date -Iseconds)" \
    --arg coordinator "$WORKER_LABEL" \
    '{runId: $runId, roomId: $roomId, createdAt: $createdAt, coordinator: $coordinator}' \
    > /tmp/openchat-shared-room.json
  gcloud storage cp /tmp/openchat-shared-room.json "gs://$BUCKET_NAME/runs/$RUN_ID/shared-room.json"
  cp /tmp/openchat-shared-room.json "$RESULT_ROOT/metrics/shared-room.json"
  echo "[k6] created shared room room_id=$SHARED_ROOM_ID"
}

wait_for_shared_room() {
  echo "[k6] waiting for shared room marker"
  for attempt in $(seq 1 180); do
    if gcloud storage cp "gs://$BUCKET_NAME/runs/$RUN_ID/shared-room.json" /tmp/openchat-shared-room.json >/dev/null 2>&1; then
      SHARED_ROOM_ID=$(jq -r '.roomId // empty' /tmp/openchat-shared-room.json)
      if [ -n "$SHARED_ROOM_ID" ]; then
        cp /tmp/openchat-shared-room.json "$RESULT_ROOT/metrics/shared-room.json"
        echo "[k6] found shared room room_id=$SHARED_ROOM_ID"
        return 0
      fi
    fi
    if [ "$attempt" -eq 180 ]; then
      echo "[k6] shared room marker timeout" >&2
      return 1
    fi
    sleep 2
  done
}

prometheus_query_json() {
  local query="$1"
  local response
  response=$(curl --max-time 10 -sfG \
    --data-urlencode "query=$query" \
    "http://$MONITORING_INTERNAL_IP:9090/api/v1/query" 2>/dev/null || true)

  if [ -z "$response" ]; then
    printf '{"status":"error","error":"query failed"}'
    return 0
  fi

  printf '%s' "$response" | jq -c '{status, resultType: .data.resultType, result: .data.result}'
}

write_prometheus_field() {
  local name="$1"
  local query="$2"
  local first="$3"

  if [ "$first" != "true" ]; then
    printf ',\n'
  fi
  printf '    "%s": ' "$name"
  prometheus_query_json "$query"
}

collect_prometheus_tps_summary() {
  local label="$1"
  local output_dir="$2"
  local safe_label="$${label//\'/}"
  local output_file="$output_dir/$${safe_label}-prometheus-tps-summary.json"
  local window_seconds=$((CONNECT_RAMP_SECONDS + CHAT_DURATION_SECONDS + 90))

  if [ "$ENABLE_MONITORING" != "true" ] || [ -z "$MONITORING_INTERNAL_IP" ]; then
    echo "{\"label\":\"$safe_label\",\"error\":\"monitoring disabled\"}" > "$output_file"
    return 0
  fi

  if ! curl --max-time 3 -sf "http://$MONITORING_INTERNAL_IP:9090/-/healthy" >/dev/null; then
    echo "{\"label\":\"$safe_label\",\"error\":\"prometheus unavailable\"}" > "$output_file"
    return 0
  fi

  {
    printf '{\n'
    printf '  "label": "%s",\n' "$safe_label"
    printf '  "collectedAt": "%s",\n' "$(date -Iseconds)"
    printf '  "rateWindow": "1m",\n'
    printf '  "peakRateWindow": "30s",\n'
    printf '  "increaseWindow": "%ss",\n' "$window_seconds"
    printf '  "queries": {\n'

    write_prometheus_field "input_msg_per_sec_1m" 'sum(rate(openchat_pipeline_stage_seconds_count{stage="ws.inbound.total"}[1m]))' true
    write_prometheus_field "ack_after_send_per_sec_1m" 'sum(rate(openchat_pipeline_since_created_seconds_count{stage="ws.ack.after_send.since_client_sent"}[1m]))' false
    write_prometheus_field "db_insert_per_sec_1m" 'sum(rate(openchat_pipeline_events_total{event="ingest.db_insert.success"}[1m]))' false
    write_prometheus_field "ws_delivery_per_sec_1m" 'sum(rate(openchat_pipeline_events_total{event="ws.send.succeeded"}[1m]))' false
    write_prometheus_field "ws_frame_per_sec_1m" 'sum(rate(openchat_pipeline_events_total{event="ws.send.frame.succeeded"}[1m]))' false
    write_prometheus_field "ws_send_bytes_per_sec_1m" 'sum(rate(openchat_pipeline_events_total{event="ws.send.bytes"}[1m]))' false
    write_prometheus_field "ws_send_failed_per_sec_1m" 'sum(rate(openchat_pipeline_events_total{event="ws.send.failed"}[1m]))' false
    write_prometheus_field "input_msg_per_sec_30s_max" "max_over_time(sum(rate(openchat_pipeline_stage_seconds_count{stage=\"ws.inbound.total\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "input_msg_per_sec_30s_avg" "avg_over_time(sum(rate(openchat_pipeline_stage_seconds_count{stage=\"ws.inbound.total\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "ack_after_send_per_sec_30s_max" "max_over_time(sum(rate(openchat_pipeline_since_created_seconds_count{stage=\"ws.ack.after_send.since_client_sent\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "ack_after_send_per_sec_30s_avg" "avg_over_time(sum(rate(openchat_pipeline_since_created_seconds_count{stage=\"ws.ack.after_send.since_client_sent\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "db_insert_per_sec_30s_max" "max_over_time(sum(rate(openchat_pipeline_events_total{event=\"ingest.db_insert.success\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "db_insert_per_sec_30s_avg" "avg_over_time(sum(rate(openchat_pipeline_events_total{event=\"ingest.db_insert.success\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "ws_delivery_per_sec_30s_max" "max_over_time(sum(rate(openchat_pipeline_events_total{event=\"ws.send.succeeded\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "ws_delivery_per_sec_30s_avg" "avg_over_time(sum(rate(openchat_pipeline_events_total{event=\"ws.send.succeeded\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "ws_frame_per_sec_30s_max" "max_over_time(sum(rate(openchat_pipeline_events_total{event=\"ws.send.frame.succeeded\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "ws_frame_per_sec_30s_avg" "avg_over_time(sum(rate(openchat_pipeline_events_total{event=\"ws.send.frame.succeeded\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "ws_send_bytes_per_sec_30s_max" "max_over_time(sum(rate(openchat_pipeline_events_total{event=\"ws.send.bytes\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "ws_send_bytes_per_sec_30s_avg" "avg_over_time(sum(rate(openchat_pipeline_events_total{event=\"ws.send.bytes\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "ws_send_failed_per_sec_30s_max" "max_over_time(sum(rate(openchat_pipeline_events_total{event=\"ws.send.failed\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "process_cpu_usage_30s_max" "max_over_time(max(process_cpu_usage{application=\"openchat\"})[$${window_seconds}s:5s])" false
    write_prometheus_field "process_cpu_usage_30s_avg" "avg_over_time(max(process_cpu_usage{application=\"openchat\"})[$${window_seconds}s:5s])" false
    write_prometheus_field "realtime_process_cpu_usage_30s_max" "max_over_time(max(process_cpu_usage{application=\"openchat\",role=\"realtime\"})[$${window_seconds}s:5s])" false
    write_prometheus_field "realtime_process_cpu_usage_30s_avg" "avg_over_time(max(process_cpu_usage{application=\"openchat\",role=\"realtime\"})[$${window_seconds}s:5s])" false
    write_prometheus_field "gc_pause_per_sec_30s_max" "max_over_time(sum(rate(jvm_gc_pause_seconds_count{application=\"openchat\"}[30s]))[$${window_seconds}s:5s])" false
    write_prometheus_field "jvm_threads_live_max" "max_over_time(max(jvm_threads_live_threads{application=\"openchat\"})[$${window_seconds}s:5s])" false
    write_prometheus_field "input_msg_increase_window" "sum(increase(openchat_pipeline_stage_seconds_count{stage=\"ws.inbound.total\"}[$${window_seconds}s]))" false
    write_prometheus_field "ack_after_send_increase_window" "sum(increase(openchat_pipeline_since_created_seconds_count{stage=\"ws.ack.after_send.since_client_sent\"}[$${window_seconds}s]))" false
    write_prometheus_field "db_insert_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ingest.db_insert.success\"}[$${window_seconds}s]))" false
    write_prometheus_field "ws_delivery_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ws.send.succeeded\"}[$${window_seconds}s]))" false
    write_prometheus_field "ws_frame_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ws.send.frame.succeeded\"}[$${window_seconds}s]))" false
    write_prometheus_field "ws_send_bytes_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ws.send.bytes\"}[$${window_seconds}s]))" false
    write_prometheus_field "ws_send_failed_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ws.send.failed\"}[$${window_seconds}s]))" false
    write_prometheus_field "ws_fanout_active_sessions_max" 'max(ws_fanout_max{type="active_sessions"})' false
    write_prometheus_field "ws_session_active_max" 'max(ws_session_max{type="active"})' false
    write_prometheus_field "ws_session_passive_max" 'max(ws_session_max{type="passive"})' false
    write_prometheus_field "ws_fanout_passive_omitted_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ws.fanout.passive_omitted\"}[$${window_seconds}s]))" false
    write_prometheus_field "ws_send_fail_closed_before_send_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ws.send.fail.closed_before_send\"}[$${window_seconds}s]))" false
    write_prometheus_field "ws_send_fail_closed_during_send_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ws.send.fail.closed_during_send\"}[$${window_seconds}s]))" false
    write_prometheus_field "ws_send_fail_send_time_limit_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ws.send.fail.send_time_limit\"}[$${window_seconds}s]))" false
    write_prometheus_field "ws_send_fail_buffer_limit_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ws.send.fail.buffer_limit\"}[$${window_seconds}s]))" false
    write_prometheus_field "ws_send_fail_io_exception_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ws.send.fail.io_exception\"}[$${window_seconds}s]))" false
    write_prometheus_field "ws_send_fail_illegal_state_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ws.send.fail.illegal_state\"}[$${window_seconds}s]))" false
    write_prometheus_field "ws_send_fail_unknown_exception_increase_window" "sum(increase(openchat_pipeline_events_total{event=\"ws.send.fail.unknown_exception\"}[$${window_seconds}s]))" false
    write_prometheus_field "ack_after_send_p95_seconds" 'max(openchat_pipeline_since_created_seconds{stage="ws.ack.after_send.since_client_sent",quantile="0.95"})' false
    write_prometheus_field "broadcast_lane_done_p95_seconds" 'max(openchat_pipeline_since_created_seconds{stage="ws.broadcast.lane_done.since_created",quantile="0.95"})' false
    write_prometheus_field "ws_send_duration_p95_seconds" 'max(openchat_pipeline_stage_seconds{stage="ws.send.duration",quantile="0.95"})' false
    write_prometheus_field "targets_up" 'up' false

    printf '\n  }\n'
    printf '}\n'
  } > "$output_file"
}

sync_results() {
  gcloud storage rsync -r "$RESULT_ROOT" "gs://$BUCKET_NAME/runs/$RUN_ID" || true
  gcloud storage cp --recursive "$LOG_DIR" "gs://$BUCKET_NAME/runs/$RUN_ID/logs/k6-vm/$WORKER_LABEL/" || true
}

write_done_marker() {
  local marker="/tmp/openchat-k6-$WORKER_LABEL.done"
  date -Iseconds > "$marker"
  gcloud storage cp "$marker" "gs://$BUCKET_NAME/runs/$RUN_ID/workers/$WORKER_LABEL.done" || true
}

wait_for_workers_done() {
  echo "[k6] waiting for $K6_WORKER_COUNT worker done markers"
  for attempt in $(seq 1 180); do
    local done_count
    done_count=$(gcloud storage ls "gs://$BUCKET_NAME/runs/$RUN_ID/workers/*.done" 2>/dev/null | wc -l | tr -d ' ')
    if [ "$done_count" -ge "$K6_WORKER_COUNT" ]; then
      echo "[k6] all worker done markers found count=$done_count"
      return 0
    fi
    if [ "$attempt" -eq 180 ]; then
      echo "[k6] worker done marker timeout count=$done_count/$K6_WORKER_COUNT" >&2
      return 1
    fi
    sleep 2
  done
}

delete_vm() {
  local vm="$1"
  if [ -n "$vm" ]; then
    echo "[k6] deleting vm $vm"
    gcloud compute instances delete "$vm" --project "$PROJECT_ID" --zone "$ZONE" --quiet || true
  fi
}

cleanup() {
  local exit_code=$?
  echo "[k6] cleanup begin worker=$WORKER_LABEL coordinator=$K6_IS_COORDINATOR exit_code=$exit_code"

  collect_socket_snapshot "socket-after"
  sync_results
  write_done_marker

  if [ "$K6_CLEANUP_ENABLED" != "true" ]; then
    echo "[k6] cleanup disabled; leaving VMs running for manual smoke verification"
    exit "$exit_code"
  fi

  if [ "$K6_IS_COORDINATOR" != "true" ]; then
    echo "[k6] non-coordinator scheduling self delete $K6_VM_NAME"
    (sleep 5; gcloud compute instances delete "$K6_VM_NAME" --project "$PROJECT_ID" --zone "$ZONE" --quiet) >/tmp/openchat-self-delete.log 2>&1 &
    exit "$exit_code"
  fi

  wait_for_workers_done || true

  if [ "$SHARED_ROOM_MODE" = "true" ] && [ -n "$SHARED_TEST_LABEL" ]; then
    shared_output_dir="$RESULT_ROOT/k6/$PROFILE/shared"
    mkdir -p "$shared_output_dir"
    collect_db_message_count "$SHARED_TEST_LABEL" "$shared_output_dir"
    collect_prometheus_tps_summary "$SHARED_TEST_LABEL" "$shared_output_dir"
    sync_results
  fi

  collect_app_snapshots "after"

  sync_results

  delete_vm "$LB_VM_NAME"
  for vm in $APP_VM_NAMES; do
    delete_vm "$vm"
  done
  delete_vm "$MYSQL_VM_NAME"
  delete_vm "$REDIS_VM_NAME"
  delete_vm "$MONITORING_VM_NAME"

  for vm in $K6_VM_NAMES; do
    if [ "$vm" != "$K6_VM_NAME" ]; then
      delete_vm "$vm"
    fi
  done

  echo "[k6] scheduling self delete $K6_VM_NAME"
  (sleep 5; gcloud compute instances delete "$K6_VM_NAME" --project "$PROJECT_ID" --zone "$ZONE" --quiet) >/tmp/openchat-self-delete.log 2>&1 &

  exit "$exit_code"
}
trap cleanup EXIT

echo "[k6] startup begin run_id=$RUN_ID worker=$WORKER_LABEL/$K6_WORKER_COUNT profile=$PROFILE vus_list=$VUS_LIST base=$BASE_URL connect_ramp_seconds=$CONNECT_RAMP_SECONDS hot_rooms=$HOT_ROOMS vus_per_room=$VUS_PER_ROOM monitoring=$ENABLE_MONITORING shared_room_mode=$SHARED_ROOM_MODE cleanup=$K6_CLEANUP_ENABLED"
apply_socket_tuning
collect_socket_snapshot "socket-before"

export DEBIAN_FRONTEND=noninteractive
apt_update_with_retry
apt_install_with_retry unzip curl jq gnupg ca-certificates iproute2 default-mysql-client

if ! command -v gcloud >/dev/null 2>&1; then
  curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
    | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg
  echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
    > /etc/apt/sources.list.d/google-cloud-sdk.list
fi

curl -fsSL https://dl.k6.io/key.gpg | gpg --dearmor -o /usr/share/keyrings/k6-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/k6-archive-keyring.gpg] https://dl.k6.io/deb stable main" \
  > /etc/apt/sources.list.d/k6.list
apt_update_with_retry
apt_install_with_retry k6 google-cloud-cli iproute2 default-mysql-client

rm -rf "$WORKDIR"
mkdir -p "$WORKDIR"
for attempt in $(seq 1 30); do
  if gcloud storage cp "gs://$BUCKET_NAME/$SOURCE_OBJECT" /tmp/openchat-source.zip; then
    break
  fi
  if [ "$attempt" -eq 30 ]; then
    echo "[k6] failed to download source archive" >&2
    exit 1
  fi
  sleep 5
done
unzip -q /tmp/openchat-source.zip -d "$WORKDIR"
cd "$WORKDIR"

echo "[k6] waiting for lb health at $BASE_URL"
for attempt in $(seq 1 240); do
  if curl --max-time 3 -sf "$BASE_URL/actuator/health" >/dev/null; then
    echo "[k6] lb healthy"
    break
  fi
  if [ "$attempt" -eq 240 ]; then
    echo "[k6] lb did not become healthy" >&2
    exit 1
  fi
  sleep 2
done

collect_app_snapshots "before"

if [ "$ENABLE_MONITORING" = "true" ] && [ -n "$MONITORING_INTERNAL_IP" ]; then
  echo "[k6] waiting for influxdb at $MONITORING_INTERNAL_IP"
  for attempt in $(seq 1 180); do
    if curl --max-time 3 -sf "http://$MONITORING_INTERNAL_IP:8086/ping" >/dev/null; then
      echo "[k6] influxdb healthy"
      break
    fi
    if [ "$attempt" -eq 180 ]; then
      echo "[k6] influxdb did not become healthy" >&2
      exit 1
    fi
    sleep 2
  done
fi

if [ "$SHARED_ROOM_MODE" = "true" ]; then
  if [ "$HOT_ROOMS" -ne 1 ]; then
    echo "[k6] shared_room_mode requires hot_rooms=1" >&2
    exit 1
  fi

  if [ "$K6_IS_COORDINATOR" = "true" ]; then
    create_shared_room
  else
    wait_for_shared_room
  fi
fi

echo "[k6] writing ready marker"
ready_marker="/tmp/openchat-k6-$WORKER_LABEL.ready"
date -Iseconds > "$ready_marker"
gcloud storage cp "$ready_marker" "gs://$BUCKET_NAME/runs/$RUN_ID/workers/$WORKER_LABEL.ready" || true

echo "[k6] waiting for $K6_WORKER_COUNT ready markers"
for attempt in $(seq 1 180); do
  ready_count=$(gcloud storage ls "gs://$BUCKET_NAME/runs/$RUN_ID/workers/*.ready" 2>/dev/null | wc -l | tr -d ' ')
  if [ "$ready_count" -ge "$K6_WORKER_COUNT" ]; then
    echo "[k6] all ready markers found count=$ready_count"
    break
  fi
  if [ "$attempt" -eq 180 ]; then
    echo "[k6] ready marker timeout count=$ready_count/$K6_WORKER_COUNT" >&2
    exit 1
  fi
  sleep 2
done

if [ "$SHARED_ROOM_MODE" != "true" ] && [ "$K6_WORKER_COUNT" -gt 1 ] && [ $((HOT_ROOMS % K6_WORKER_COUNT)) -ne 0 ]; then
  echo "[k6] HOT_ROOMS must be divisible by K6_WORKER_COUNT for distributed workers" >&2
  exit 1
fi

worker_hot_rooms="$HOT_ROOMS"
room_index_offset=0
if [ "$SHARED_ROOM_MODE" = "true" ]; then
  worker_hot_rooms=1
elif [ "$K6_WORKER_COUNT" -gt 1 ]; then
  worker_hot_rooms=$((HOT_ROOMS / K6_WORKER_COUNT))
  room_index_offset=$(((K6_WORKER_INDEX - 1) * worker_hot_rooms))
fi

overall_status=0
for vus in $VUS_LIST; do
  worker_vus="$vus"
  if [ "$K6_WORKER_COUNT" -gt 1 ]; then
    if [ $((vus % K6_WORKER_COUNT)) -ne 0 ]; then
      echo "[k6] VU value $vus must be divisible by K6_WORKER_COUNT=$K6_WORKER_COUNT" >&2
      exit 1
    fi
    worker_vus=$((vus / K6_WORKER_COUNT))
  fi

  vu_index_offset=0
  if [ "$SHARED_ROOM_MODE" = "true" ]; then
    vu_index_offset=$(((K6_WORKER_INDEX - 1) * worker_vus))
  fi

  label="$PROFILE-$WORKER_LABEL-$${worker_vus}vu"
  test_label="$label"
  if [ "$SHARED_ROOM_MODE" = "true" ]; then
    test_label="$PROFILE-shared-$${vus}vu"
    SHARED_TEST_LABEL="$test_label"
  fi
  output_dir="$RESULT_ROOT/k6/$PROFILE/$WORKER_LABEL"
  echo "[k6] running $label test_label=$test_label worker_vus=$worker_vus total_vus=$vus worker_hot_rooms=$worker_hot_rooms room_index_offset=$room_index_offset vu_index_offset=$vu_index_offset shared_room_id=$SHARED_ROOM_ID"

  influx_args=()
  if [ "$ENABLE_MONITORING" = "true" ] && [ -n "$MONITORING_INTERNAL_IP" ]; then
    influx_args=(--out "influxdb=http://$MONITORING_INTERNAL_IP:8086/k6")
  fi

  workload_snapshot_pid=""
  if [ "$K6_IS_COORDINATOR" = "true" ]; then
    collect_workload_snapshots_during_run "$${worker_vus}vu" &
    workload_snapshot_pid=$!
  fi
  node_drain_pid=""
  node_drain_status=0
  if [ "$K6_IS_COORDINATOR" = "true" ] && [ "$K6_ROLLING_RESTART_ENABLED" = "true" ]; then
    trigger_rolling_restart_during_run "$${worker_vus}vu" &
    node_drain_pid=$!
  elif [ "$K6_IS_COORDINATOR" = "true" ] && [ "$K6_NODE_DRAIN_ENABLED" = "true" ]; then
    trigger_node_drain_during_run "$${worker_vus}vu" &
    node_drain_pid=$!
  fi

  set +e
  K6_INFLUXDB_PAYLOAD_SIZE=5000000 \
  K6_INFLUXDB_CONCURRENT_WRITES=16 \
  k6 run \
    "$${influx_args[@]}" \
    --summary-export "$output_dir/$${worker_vus}vu-summary.json" \
    -e BASE_URL="$BASE_URL" \
    -e WS_BASE_URL="$WS_BASE_URL" \
    -e TARGET_VUS="$worker_vus" \
    -e TOTAL_TARGET_VUS="$vus" \
    -e TEST_LABEL="$test_label" \
    -e SEND_INTERVAL_MS="$SEND_INTERVAL_MS" \
    -e CHAT_DURATION_SECONDS="$CHAT_DURATION_SECONDS" \
    -e K6_WS_SEND_STOP_AFTER_SECONDS="$K6_WS_SEND_STOP_AFTER_SECONDS" \
    -e K6_CHAT_ACK_P95_THRESHOLD_MS="$K6_CHAT_ACK_P95_THRESHOLD_MS" \
    -e K6_VISIBLE_FRESHNESS_P95_THRESHOLD_MS="$K6_VISIBLE_FRESHNESS_P95_THRESHOLD_MS" \
    -e K6_VISIBLE_LATEST_FRESHNESS_P95_THRESHOLD_MS="$K6_VISIBLE_LATEST_FRESHNESS_P95_THRESHOLD_MS" \
    -e K6_ASSIGNMENT_PREFLIGHT_ENABLED="$K6_ASSIGNMENT_PREFLIGHT_ENABLED" \
    -e K6_ASSIGNMENT_PREFLIGHT_PARTITION_COUNT="$K6_ASSIGNMENT_PREFLIGHT_PARTITION_COUNT" \
    -e K6_ASSIGNMENT_PREFLIGHT_EXPECTED_NODES="$K6_ASSIGNMENT_PREFLIGHT_EXPECTED_NODES" \
    -e K6_ASSIGNMENT_PREFLIGHT_TIMEOUT_SECONDS="$K6_ASSIGNMENT_PREFLIGHT_TIMEOUT_SECONDS" \
    -e CONNECT_RAMP_SECONDS="$CONNECT_RAMP_SECONDS" \
    -e HOT_ROOMS="$worker_hot_rooms" \
    -e VUS_PER_ROOM="$VUS_PER_ROOM" \
    -e ROOM_INDEX_OFFSET="$room_index_offset" \
    -e VU_INDEX_OFFSET="$vu_index_offset" \
    -e K6_WORKER_INDEX="$K6_WORKER_INDEX" \
    -e K6_WORKER_COUNT="$K6_WORKER_COUNT" \
    -e SHARED_ROOM_MODE="$SHARED_ROOM_MODE" \
    -e SHARED_ROOM_ID="$SHARED_ROOM_ID" \
    -e K6_SENDER_RATIO="$K6_SENDER_RATIO" \
    -e K6_OBSERVER_RATIO="$K6_OBSERVER_RATIO" \
    -e K6_VALIDATOR_RATIO="$K6_VALIDATOR_RATIO" \
    -e OBSERVER_SEND_INTERVAL_MS="$OBSERVER_SEND_INTERVAL_MS" \
    -e ACTIVE_USER_RATIO="$ACTIVE_USER_RATIO" \
    -e ACTIVE_HEARTBEAT_INTERVAL_MS="$ACTIVE_HEARTBEAT_INTERVAL_MS" \
    -e PASSIVE_SETTLE_MS="$PASSIVE_SETTLE_MS" \
    -e MIXED_HOT_ROOM_COUNT="$MIXED_HOT_ROOM_COUNT" \
    -e MIXED_HOT_ROOM_VUS="$MIXED_HOT_ROOM_VUS" \
    -e MIXED_HOT_ACTIVE_RATIO="$MIXED_HOT_ACTIVE_RATIO" \
    -e MIXED_HOT_SEND_INTERVAL_MS="$MIXED_HOT_SEND_INTERVAL_MS" \
    -e MIXED_LARGE_ROOM_COUNT="$MIXED_LARGE_ROOM_COUNT" \
    -e MIXED_LARGE_ROOM_VUS="$MIXED_LARGE_ROOM_VUS" \
    -e MIXED_LARGE_ACTIVE_RATIO="$MIXED_LARGE_ACTIVE_RATIO" \
    -e MIXED_LARGE_SEND_INTERVAL_MS="$MIXED_LARGE_SEND_INTERVAL_MS" \
    -e MIXED_MEDIUM_ROOM_COUNT="$MIXED_MEDIUM_ROOM_COUNT" \
    -e MIXED_MEDIUM_ROOM_VUS="$MIXED_MEDIUM_ROOM_VUS" \
    -e MIXED_MEDIUM_ACTIVE_RATIO="$MIXED_MEDIUM_ACTIVE_RATIO" \
    -e MIXED_MEDIUM_SEND_INTERVAL_MS="$MIXED_MEDIUM_SEND_INTERVAL_MS" \
    -e MIXED_SMALL_ROOM_COUNT="$MIXED_SMALL_ROOM_COUNT" \
    -e MIXED_SMALL_ROOM_VUS="$MIXED_SMALL_ROOM_VUS" \
    -e MIXED_SMALL_ACTIVE_RATIO="$MIXED_SMALL_ACTIVE_RATIO" \
    -e MIXED_SMALL_SEND_INTERVAL_MS="$MIXED_SMALL_SEND_INTERVAL_MS" \
    -e K6_COUNTER_FLUSH_INTERVAL_MS="5000" \
    -e K6_VISIBLE_FRESHNESS_SAMPLE_EVERY="100" \
    "$SCENARIO" 2>&1 | tee "$output_dir/$${worker_vus}vu.log"
  k6_status=$${PIPESTATUS[0]}
  raw_k6_status="$k6_status"
  set -e

  if [ -n "$workload_snapshot_pid" ]; then
    kill "$workload_snapshot_pid" 2>/dev/null || true
    wait "$workload_snapshot_pid" 2>/dev/null || true
  fi
  if [ -n "$node_drain_pid" ]; then
    wait "$node_drain_pid" 2>/dev/null || node_drain_status=$?
  fi

  if [ "$node_drain_status" -ne 0 ] && [ "$k6_status" -eq 0 ]; then
    k6_status="$node_drain_status"
  fi
  if [ "$k6_status" -ne 0 ] && [ "$overall_status" -eq 0 ]; then
    overall_status="$k6_status"
  fi
  echo "$k6_status" > "$output_dir/$${worker_vus}vu-exit-code.txt"
  if [ "$ENABLE_MONITORING" = "true" ] && [ -n "$MONITORING_INTERNAL_IP" ]; then
    sleep 10
  fi
  if [ "$SHARED_ROOM_MODE" = "true" ]; then
    echo "[k6] shared mode defers global DB/prometheus summary to coordinator cleanup"
  else
    collect_db_message_count "$test_label" "$output_dir"
    collect_prometheus_tps_summary "$test_label" "$output_dir"
    write_validation_gates \
      "$${worker_vus}vu" \
      "$output_dir" \
      "$output_dir/$${worker_vus}vu-summary.json" \
      "$output_dir/$test_label-db-message-count.json" \
      "$raw_k6_status" \
      "$node_drain_status"
  fi
  echo "[k6] finished $label exit_code=$k6_status"
done

cat > "$RESULT_ROOT/run-metadata-$WORKER_LABEL.json" <<EOF
{
  "runId": "$RUN_ID",
  "profile": "$PROFILE",
  "workerLabel": "$WORKER_LABEL",
  "workerIndex": $K6_WORKER_INDEX,
  "workerCount": $K6_WORKER_COUNT,
  "vusList": "$VUS_LIST",
  "chatDurationSeconds": $CHAT_DURATION_SECONDS,
  "sendIntervalMs": $SEND_INTERVAL_MS,
  "connectRampSeconds": $CONNECT_RAMP_SECONDS,
  "hotRooms": $HOT_ROOMS,
  "workerHotRooms": $worker_hot_rooms,
  "vusPerRoom": $VUS_PER_ROOM,
  "roomIndexOffset": $room_index_offset,
  "sharedRoomMode": "$SHARED_ROOM_MODE",
  "sharedRoomId": "$SHARED_ROOM_ID",
  "sharedTestLabel": "$SHARED_TEST_LABEL",
  "totalTargetVus": "$VUS_LIST",
  "workerTargetVus": "$worker_vus",
  "k6SenderRatio": "$K6_SENDER_RATIO",
  "k6ObserverRatio": "$K6_OBSERVER_RATIO",
  "k6ValidatorRatio": "$K6_VALIDATOR_RATIO",
  "observerSendIntervalMs": "$OBSERVER_SEND_INTERVAL_MS",
  "activeUserRatio": "$ACTIVE_USER_RATIO",
  "activeHeartbeatIntervalMs": "$ACTIVE_HEARTBEAT_INTERVAL_MS",
  "passiveSettleMs": "$PASSIVE_SETTLE_MS",
  "mixedHotRoomCount": "$MIXED_HOT_ROOM_COUNT",
  "mixedHotRoomVus": "$MIXED_HOT_ROOM_VUS",
  "mixedLargeRoomCount": "$MIXED_LARGE_ROOM_COUNT",
  "mixedLargeRoomVus": "$MIXED_LARGE_ROOM_VUS",
  "mixedMediumRoomCount": "$MIXED_MEDIUM_ROOM_COUNT",
  "mixedMediumRoomVus": "$MIXED_MEDIUM_ROOM_VUS",
  "mixedSmallRoomCount": "$MIXED_SMALL_ROOM_COUNT",
  "mixedSmallRoomVus": "$MIXED_SMALL_ROOM_VUS",
  "baseUrl": "$BASE_URL",
  "wsBaseUrl": "$WS_BASE_URL",
  "lbVmName": "$LB_VM_NAME",
  "appVmNames": "$APP_VM_NAMES",
  "mysqlVmName": "$MYSQL_VM_NAME",
  "redisVmName": "$REDIS_VM_NAME",
  "monitoringVmName": "$MONITORING_VM_NAME",
  "k6VmName": "$K6_VM_NAME",
  "k6VmNames": "$K6_VM_NAMES",
  "rollingRestartEnabled": "$K6_ROLLING_RESTART_ENABLED",
  "rollingRestartTargetCount": "$K6_ROLLING_RESTART_TARGET_COUNT",
  "rollingRestartMinActiveNodes": "$K6_ROLLING_RESTART_MIN_ACTIVE_NODES",
  "rollingRestartIntervalSeconds": "$K6_ROLLING_RESTART_INTERVAL_SECONDS"
}
EOF

echo "[k6] completed worker=$WORKER_LABEL exit_code=$overall_status"
exit "$overall_status"
