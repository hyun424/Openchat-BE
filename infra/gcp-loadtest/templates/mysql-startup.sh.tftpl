#!/usr/bin/env bash
set -euo pipefail

RUN_ID="${run_id}"
BUCKET_NAME="${bucket_name}"
LOG_DIR="/var/log/openchat-loadtest"
DATA_DIR="/var/lib/openchat-mysql"

mkdir -p "$LOG_DIR" "$DATA_DIR"
exec > >(tee -a "$LOG_DIR/mysql-startup.log") 2>&1

apt_update_with_retry() {
  local attempt
  local delay
  for attempt in $(seq 1 5); do
    echo "[apt] update attempt $attempt/5"
    if apt-get update -o Acquire::Retries=3; then
      return 0
    fi
    delay=$((attempt * 10))
    echo "[apt] update failed attempt $attempt; retrying in $delay seconds" >&2
    apt-get clean || true
    rm -rf /var/lib/apt/lists/partial/* || true
    sleep "$delay"
  done
  echo "[apt] update failed after retries" >&2
  return 1
}

apt_install_with_retry() {
  local attempt
  local delay
  for attempt in $(seq 1 3); do
    echo "[apt] install attempt $attempt/3 packages=$*"
    if apt-get install -y "$@"; then
      return 0
    fi
    delay=$((attempt * 10))
    echo "[apt] install failed attempt $attempt; retrying in $delay seconds" >&2
    sleep "$delay"
  done
  echo "[apt] install failed after retries packages=$*" >&2
  return 1
}

echo "[mysql] startup begin run_id=$RUN_ID bucket=$BUCKET_NAME"

export DEBIAN_FRONTEND=noninteractive
apt_update_with_retry
apt_install_with_retry docker.io curl jq gnupg ca-certificates iproute2
systemctl enable --now docker

if ! command -v gcloud >/dev/null 2>&1; then
  curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
    | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg
  echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
    > /etc/apt/sources.list.d/google-cloud-sdk.list
  apt_update_with_retry
  apt_install_with_retry google-cloud-cli
fi

docker rm -f openchat-mysql >/dev/null 2>&1 || true
docker run -d \
  --name openchat-mysql \
  --restart unless-stopped \
  -p 3306:3306 \
  -v "$DATA_DIR:/var/lib/mysql" \
  -e MYSQL_ROOT_PASSWORD=root \
  -e MYSQL_DATABASE=openchat \
  -e MYSQL_USER=openchat \
  -e MYSQL_PASSWORD=openchat \
  mysql:8.0 \
  --character-set-server=utf8mb4 \
  --collation-server=utf8mb4_unicode_ci

echo "[mysql] waiting for mysqladmin ping"
for attempt in $(seq 1 120); do
  if docker exec openchat-mysql mysqladmin ping -h 127.0.0.1 -uroot -proot --silent; then
    echo "[mysql] healthy"
    exit 0
  fi
  if [ "$attempt" -eq 120 ]; then
    echo "[mysql] did not become healthy" >&2
    docker logs openchat-mysql > "$LOG_DIR/openchat-mysql-failed.log" 2>&1 || true
    exit 1
  fi
  sleep 2
done
